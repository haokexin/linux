config SND_BST_I2S
	tristate "BST I2S Device Driver"
	#depends on CLKDEV_LOOKUP
	select SND_SOC_GENERIC_DMAENGINE_PCM
	help
	 Say Y or M if you want to add support for I2S driver for
	 Synopsys designware I2S device.
	 The device supports up to a maximum of 8 channels each for
	 play and record.

config SND_BST_PCM
	bool "PCM PIO extension for I2S driver"
	depends on SND_BST_I2S
	help
	 Say Y or N if you want to add a custom ALSA extension that registers
	 a PCM and uses PIO to transfer data.

	 This functionality is specially suited for I2S devices that don't have
	 DMA support.

	
config SND_BST_TDM
	tristate "BST TDM Device Driver"
	#depends on CLKDEV_LOOKUP
	select SND_SOC_GENERIC_DMAENGINE_PCM
	help
	 Say Y or M if you want to add support for TDM driver for
	 Synopsys designware TDM device.
	 The device supports up to a maximum of 16 channels each for
	 play and record.

config SND_BST_PCM_TDM
	bool "PCM PIO extension for TDM driver"
	depends on SND_BST_TDM
	help
	 Say Y or N if you want to add a custom ALSA extension that registers
	 a PCM and uses PIO to transfer data.

	 This functionality is specially suited for TDM devices that don't have
	 DMA support.

