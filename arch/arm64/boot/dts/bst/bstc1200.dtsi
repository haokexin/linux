				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				#gpio-cells = <2>;
				snps,nr-gpios = <32>;
				reg = <0>;
				chipnum-base = <160>;
				interrupt-controller;
				#interrupt-cells = <3>;
				interrupt-parent = <&gic600>;
				interrupts = <GIC_SPI 252 (IRQ_TYPE_LEVEL_HIGH)>;
			};
		};

		gpio6: gpio@20039000 {
			status = "disable";
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "snps,dw-apb-gpio";
			reg = <0x0 0x20039000 0x0 0x1000>;

			clock-names = "bus","db";
			clocks = <&scmi_clk GATE_LSP1_GPIO2_DBCLK_EN>,<&scmi_clk GATE_LSP1_GPIO2_PCLK_EN>;

			portg: gpio-controller@0 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				#gpio-cells = <2>;
				snps,nr-gpios = <32>;
				reg = <0>;
				chipnum-base = <192>;
				interrupt-controller;
				#interrupt-cells = <3>;
				interrupt-parent = <&gic600>;
				interrupts = <GIC_SPI 252 (IRQ_TYPE_LEVEL_HIGH)>;
			};
		};

		gpio7: gpio@2003a000 {
			status = "disable";
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "snps,dw-apb-gpio";
			reg = <0x0 0x2003a000 0x0 0x1000>;

			clock-names = "bus","db";
			clocks = <&scmi_clk GATE_LSP1_GPIO3_DBCLK_EN>,<&scmi_clk GATE_LSP1_GPIO3_PCLK_EN>;

			porth: gpio-controller@0 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				#gpio-cells = <2>;
				snps,nr-gpios = <32>;
				reg = <0>;
				chipnum-base = <224>;
				interrupt-controller;
				#interrupt-cells = <3>;
				interrupt-parent = <&gic600>;
				interrupts = <GIC_SPI 252 (IRQ_TYPE_LEVEL_HIGH)>;
			};
		};

		gpiokeys: gpio-keys@0 {
			status = "disable";
			compatible = "gpio-keys";
			#address-cells = <1>;
			#size-cells = <0>;
			key0 {
				label = "GPIO Key Enter";
				linux,code = <28>;
				linux,input-type = <1>;
				gpios = <&portf 11 GPIO_ACTIVE_LOW>;
				wakeup-source;
			};
		};

		thermal: thermal {
				status = "disable";
				compatible = "bst,bst-thermal";
				#thermal-sensor-cells = <0>;
				//simpwm-gpios = <&porta 10 GPIO_ACTIVE_HIGH>;
		};

		can0: can@21710000 {
			status = "disable";
			compatible = "bst,bst-flexcan";
			reg = <0x0 0x21710000 0x0 0x8000>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 480 IRQ_TYPE_LEVEL_HIGH>;
			clock-frequency = <80000000>;
			fsl,clk-source = <0>;
			mailbox-tx-num = <64>;
			dmas = <&gdma0 0>;
			dma-names = "rx";
		};
		can1: can@21718000 {
			status = "disable";
			compatible = "bst,bst-flexcan";
			reg = <0x0 0x21718000 0x0 0x8000>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 481 IRQ_TYPE_LEVEL_HIGH>;
			clock-frequency = <80000000>;
			fsl,clk-source = <0>;
			mailbox-tx-num = <64>;
			dmas = <&gdma0 1>;
			dma-names = "rx";
		};

		// flexray 2001:B000 // 2003:B000
		// lsp1_crm_reg 2002:0000
		// smbus2 2002:5000 // 2002:6000

		swdma0:dma-controller@217E0000 {
			status = "disable";
			#dma-cells = <1>;
			compatible = "bst,dw-axi-gdma";
			reg = <0x0 0x217E0000 0 0x1000>;
			dma-channels = <4>;
			snps,dma-masters = <1>;
			snps,data-width = <4>;
			snps,block-size = <4096 4096 4096 4096>;
			snps,priority = <3  2  1  0>;
			snps,axi-max-burst-len = <16>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 487 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
						  GIC_SPI 483 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
						  GIC_SPI 484 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
						  GIC_SPI 485 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
						  GIC_SPI 486 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)>;
		};

		// Cfg_HIO_system
		usb3_phy: phy@23003000 {
			compatible = "bst,dwc-usb-phy";
			reg = <0x0 0x23003000 0 0x1000>;
			#phy-cells = <0>;
			usb_mode = "usb31";
			pll_type = "external";
			host_force_gen1_speed;
		};

		usb2_phy: phy@23004000 {
			compatible = "bst,dwc-usb-phy";
			#phy-cells = <0>;
			reg = <0x0 0x23004000 0 0x1000>;
			usb_mode = "usb31";
			pll_type = "external";
			is_typec_phy;
			host_force_gen1_speed;
		};

		usbdrd_dwc3: usb3 {
			compatible = "bst,dwc3usb";
			status = "disable";
			ranges;
			#address-cells = <2>;
			#size-cells = <2>;
			clock-names = "u2phyref","ref", "ctrlref", "axi", "apb";
			clocks = <&scmi_clk GATE_LB_USB_0_U20_PHY_REF_CLK_EN>,
						<&scmi_clk GATE_LB_USB_0_U31_PHY_REF_CLK_EN>,
						<&scmi_clk GATE_LB_USB_0_REF_ALT_CLK_EN>,
						<&scmi_clk GATE_LB_USB_0_AXI_ACLK_EN>,
						<&scmi_clk GATE_LB_USB_0_APB_PCLK_EN>;
			resets = <&scmi_reset RST_USB3_0_SW>;
			reset-names = "usb3_reset";
			phys = <&usb3_phy>;
			phy-names = "usb-phy";
			usbdwc3: dwc3@22000000 {
				compatible = "snps,dwc3";
				reg-shift = <2>;
				reg-io-width = <4>;
				reg = <0x0 0x22000000 0x0 0x100000>;
				interrupts = <0x0 172 0x4>;
				interrupt-parent =<&gic600>;
				dr_mode = "otg";
				usb-role-switch;
				role-switch-default-mode ="peripheral";
				maximum-speed = "super-speed";
				snps,ss_gen1_deemph = <1>;
				snps,ssp_gen2_deemph = <0x8c45>,<0xE45>,<0x8d80>,<0xf80>;
				//snps,dis_u3_susphy_quirk; //lane switch must through U3 state
				//snps,dis-u1-entry-quirk;
				//snps,dis-u2-entry-quirk;
				snps,hsphy_interface = "utmi";
				phy_type = "utmi_wide";
				//iommus = <&mmu600_soc 1>;
			};
		};

		dwc3: usb2 {
			compatible = "bst,dwc3usb";
			status = "disable";
			ranges;
			#address-cells = <2>;
			#size-cells = <2>;
			clock-names = "u2phyref","ref", "ctrlref", "axi", "apb";
			clocks = <&scmi_clk GATE_LB_USB_1_U20_PHY_REF_CLK_EN>,
						<&scmi_clk GATE_LB_USB_1_U31_PHY_REF_CLK_EN>,
						<&scmi_clk GATE_LB_USB_1_REF_ALT_CLK_EN>,
						<&scmi_clk GATE_LB_USB_1_AXI_ACLK_EN>,
						<&scmi_clk GATE_LB_USB_1_APB_PCLK_EN>;
			reset-names = "usb2_reset";
			resets = <&scmi_reset RST_USB3_1_SW>;
			phys = <&usb2_phy>;
			phy-names = "usb-phy";
			usbdwc2: dwc3@22100000 {
				compatible = "snps,dwc3";
				reg = <0x0 0x22100000 0x0 0x100000>;
				interrupts = <0x0 178 0x4>;
				interrupt-parent = <&gic600>;
				dr_mode = "otg";
				usb-role-switch;
				role-switch-default-mode ="host";
				maximum-speed = "super-speed";
				snps,ss_gen1_deemph = <1>;
				snps,ssp_gen2_deemph = <0x8c45>,<0xE45>,<0x8d80>,<0xf80>;
				//snps,dis_u3_susphy_quirk; //lane switch must through U3 state
				//snps,dis-u1-entry-quirk;
				//snps,dis-u2-entry-quirk;
				snps,hsphy_interface = "utmi";
				phy_type = "utmi_wide";
				//iommus = <&mmu600_soc 2>;
			};
		};
		bst_usb_msg: usb_msg@0 {
			compatible = "bst,bst-virt-usb";
			status = "okay";
        };


		nor_flash:flash {
			compatible = "bst,virtual-qspi";
			status = "disable";
		};


        timer0:lsp_timer0@20011000 {
			status = "disable";
			#address-cells = <1>;
			#size-cells = <0>;
            compatible = "bst,bst-lsp-timer"; 
            reg = <0x0 0x20011000 0 0x1000>;                      
            interrupt-parent = <&gic600>;                     
        };

        timer1:lsp_timer1@20031000 {
			status = "disable";
			#address-cells = <1>;
			#size-cells = <0>;
            compatible = "bst,bst-lsp-timer"; 
            reg = <0x0 0x20031000 0 0x1000>;                      
            interrupt-parent = <&gic600>;                     
        };

		mmc0:dwmmc0@22200000 {
			status = "okay";
			compatible = "bst,dwcmshc-sdhci";
			reg-name = "base","crm";
			reg = <0x0 0x22200000 0x0 0x1000>,
				  <0x0 0x23006000 0x0 0x1000>;
			port = <0>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>;		//soc to db 110+32
			interrupt-names =  "IRQDWMMC0";
			#address-cells = <2>;
			#size-cells = <0>;


			clocks = <&scmi_clk GATE_LB_SDEMMC0_M_HCLK_EN>, <&scmi_clk GATE_LB_SDEMMC0_W_BCLK_EN>;
			clock-names = "core","bus";

			resets = <&scmi_reset RST_SDEMMC0_SW>;
			reset-names = "mmc_reset";



			clock-frequency = <200000000>;
			max-frequency = <200000000>;
			min-frequency = <400000>;
			mmc_crm_reg_base = <0x23006000>;
			data-addr = <0x200>;
			fifo-watermark-aligned;
			broken-64bit-dma;
			clear-tarns-mode;
			fifo-depth = <0x400>;
			card-detect-delay = <200>;
			//broken-adma;
			bus-width = <8>;
			#cap-mmc-highspeed;
			mmc-hs200-1_8v;
			non-removable;
			no-sdio;
			no-sd;
			keep-power-in-suspend;
			no-3-3-v;
			sdhci,auto-cmd12;
			dma-coherent;
			//iommus = <&mmu600_soc 8>;  //when use this, comment out memory-region attr
		};


		mmc1:dwmmc1@22300000 {
			status = "disable";
			compatible = "bst,dwcmshc-sdhci";
			reg = <0 0x22300000 0 0x1000>,
				  <0x0 0x23007000 0x0 0x1000>;
			port = <1>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 147 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)>;
			interrupt-names =  "IRQDWMMC1";
			#address-cells = <1>;
			#size-cells = <0>;
			data-addr = <0x200>;
			fifo-watermark-aligned;
			
			clocks = <&scmi_clk GATE_LB_SDEMMC1_M_HCLK_EN>, <&scmi_clk GATE_LB_SDEMMC1_W_BCLK_EN>;
			clock-names = "core","bus";		

			resets = <&scmi_reset RST_SDEMMC1_SW>;
			reset-names = "mmc_reset";


			clock-frequency = <100000000>;
			max-frequency = <200000000>;
			min-frequency = <400000>;
			mmc_crm_reg_base = <0x23007000>;
			broken-64bit-dma;
			broken-adma;
			clear-tarns-mode;
			fifo-depth = <0x400>;
			card-detect-delay = <200>;
			bus-width = <4>;
			cap-sd-highspeed;
			cap-uhs-sdr50;
			no-sdio;
			no-mmc;
			//no-1-8-v;
			sdhci,auto-cmd12;
			keep-power-in-suspend;
			dma-coherent;
		};

		mmu600_pcie: iommu@22800000 {
			status = "disable";
			compatible = "arm,smmu-v3";
			reg = <0x0 0x22800000 0x0 0x200000>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 95 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "combined";
			#iommu-cells = <1>;
			#cmn_dev_offset  = <0>;	// dev-->ddr: 1 :offset 0x10--, 0 :offset 0
			#cmn_tcu_offset = <0>;	// tcu-->ddr: 1 :offset 0x10--, 0 :offset 0
		};

		mmu600_codec: iommu@24400000 {
			status = "disable";
			compatible = "arm,smmu-v3";
			reg = <0x0 0x24400000 0 0x200000>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 281 IRQ_TYPE_LEVEL_HIGH>;    // non-secure irq
			interrupt-names = "combined";
			#iommu-cells = <1>;
			#cmn_dev_offset  = <1>; // dev-->ddr: 1 :offset 0x10--, 0 :offset 0
			#cmn_tcu_offset = <1>;  // tcu-->ddr: 1 :offset 0x10--, 0 :offset 0
		};

		mmu600_soc: iommu@31400000 {
			status = "disable";
			compatible = "arm,smmu-v3";
			reg = <0x0 0x31400000 0 0x200000>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 129 IRQ_TYPE_LEVEL_HIGH>;    // non-secure irq
			interrupt-names = "combined";
			#iommu-cells = <1>;
			#cmn_dev_offset  = <1>;	// dev-->ddr: 1 :offset 0x10--, 0 :offset 0
			#cmn_tcu_offset = <1>;	// tcu-->ddr: 1 :offset 0x10--, 0 :offset 0
			#multi_os = <1>;	// multi_os: 1 :shared use of multiple systems , 0 :single system use
		};

		mmu600_coreip: iommu@53600000 {
			status = "disable";
			compatible = "arm,smmu-v3";
			reg = <0x0 0x53600000 0 0x200000>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 374 IRQ_TYPE_LEVEL_HIGH>; // non-secure irq
			interrupt-names = "combined";
			#iommu-cells = <1>;
			#cmn_dev_offset = <0>; // dev-->ddr: 1 :offset 0x10--, 0 :offset 0
			#cmn_tcu_offset = <1>; // tcu-->ddr: 1 :offset 0x10--, 0 :offset 0
			#stage2 = <1>; // stage2 only: 1 :stage2, 0 :stage1
			#multi_os = <1>;
		};

		// mmu600_gpu: iommu@26400000

		ufs: ufs@23005000 {
			status = "disable";
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "snps,g210-tc-6.00-40bit";
			reg = <0x0 0x23005f00 0 0x100>,
			      <0x0 0x20031000 0 0x1000>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>;
			lanes-per-direction = <2>;
//			iommus = <&mmu600_soc 3>;
		};

		// sd_csr apb 2300:6000

		pcie_phy:pcie-phy@23010000 {
			reg = <0x0 0x23010000 0 0x00002000>;
			reg-names = "phy-base";
			dmc-lane = <0x1>; /* bit0: 1=2x2ports, 0=1x4ports */
			dmc-mode = <0x3>; /* (bit1 for ctl0)/(bit0 for ctl1):1=RC-mode, 0=EP-mode */
			pcie-ctl0 = <1>;  /* Controller reset */
			pcie-ctl1 = <1>;  /* Controller reset */
			pcie-ref-clk0 = <1>; /* 0=onchip_clk, 1=pad_clk*/
			pcie-ref-clk1 = <1>; /* 0=onchip_clk, 1=pad_clk, 2=repeat_clk */
		};

		pcie0:pcie@400000000 {
			status = "disable";
			compatible = "bst,dw-pcie";
			device_type = "pci";
			controller-id = <0>;
			chip-type = <0x1>; /* 0x0=A1000 0x1=C1200 */
			bus-range = <0x0 0xf>;
			linux,pci-domain = <0>;
			max-link-speed = <4>;
			num-lanes = <4>;
			reg =	<0x4 0x00000000 0 0x00010000>,
				<0x5 0x80000000 0 0x00040000>,
				<0x5 0x80080000 0 0x00040000>,
				<0x0 0x40000000 0 0x00040000>;
			reg-names = "dbi", "atu", "dma", "config";
			num-ib-windows = <16>;
			num-ob-windows = <16>;
			msi-map = <0x0 &its0_x4 0x0 0x1000>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges = <0x82000000 0x0 0x40000000 0x4 0x20000000 0x0 0x80000000>,
				 <0x83000000 0x5 0x00000000 0x5 0x00000000 0x0 0x80000000>,
				 <0xC3000000 0x5 0x90000000 0x5 0x90000000 0x0 0x70000000>;
			dma-coherent;
			// iommus = <&mmu600_pcie 0x0>;
			// iommu-map = <0x0  &mmu600_pcie 0x00 0x1000>;

			interrupt-parent = <&gic600>;
			interrupts =	<GIC_SPI 65 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 66 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 55 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 56 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 58 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 59 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 60 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 61 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 62 IRQ_TYPE_LEVEL_HIGH>;

			interrupt-names = "msi", "other", "dma0", "dma1", "dma2", "dma3", "dma4", "dma5", "dma6", "dma7";
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 0x7>;
			interrupt-map = <0 0 0 1 &pcie0_intc 0xF>,
					<0 0 0 2 &pcie0_intc 0xE>,
					<0 0 0 3 &pcie0_intc 0xD>,
					<0 0 0 4 &pcie0_intc 0xC>;
			pcie-phy = <&pcie_phy>;

			pcie0_intc: legacy-interrupt-controller {
				interrupt-controller;
				#address-cells = <0>;
				#interrupt-cells = <1>;
				interrupt-parent = <&gic600>;
				interrupts = <GIC_SPI 66 IRQ_TYPE_LEVEL_HIGH>;
			};
		};

		pcie0_ep:pcie0_ep@400000000 {
			status = "disable";
			compatible = "bst,dw-pcie-ep";
			controller-id = <0>;
			chip-type = <0x1>; /* 0x0=A1000 0x1=C1200 */
			max-link-speed = <4>;
			num-lanes = <2>;
			reg =	<0x4 0x00000000 0 0x40000000>,
				<0x4 0x80000000 0 0x40000000>,
				<0x5 0x80000000 0 0x00040000>,
				<0x5 0x80080000 0 0x00040000>,
				<0x0 0x40000000 0 0x80000000>;
			reg-names = "dbi", "dbi2", "atu", "dma", "addr_space";
			dma-coherent;
			num-ib-windows = <16>;
			num-ob-windows = <16>;
			max-functions = /bits/ 8 <8>;
			max-virtual-functions = /bits/ 8 <4 4 0 0 0 0 0 0>;
			interrupt-parent = <&gic600>;
			interrupts =	<GIC_SPI 72 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 55 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 56 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 58 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 59 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 60 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 61 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 62 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "doorbell", "dma0", "dma1", "dma2", "dma3", "dma4", "dma5", "dma6", "dma7";

			pcie-phy = <&pcie_phy>;
		};

		pcie1:pcie@600000000 {
			status = "disable";
			compatible = "bst,dw-pcie";
			device_type = "pci";
			controller-id = <1>;
			chip-type = <0x1>; /* 0x0=A1000 0x1=C1200 */
			bus-range = <0x10 0x1f>;
			linux,pci-domain = <1>;
			max-link-speed = <4>;
			num-lanes = <2>;
			reg =	<0x6 0x00000000 0 0x00010000>,
				<0x7 0x80000000 0 0x00040000>,
				<0x7 0x80080000 0 0x00040000>,
				<0x0 0x48000000 0 0x00040000>;
			reg-names = "dbi", "atu", "dma", "config";
			num-iatu = <16>;
			num-viewport = <16>;
			msi-map = <0x1000 &its1_x2 0x1000 0x1000>;
			#address-cells = <3>;
			#size-cells = <2>;
			ranges = <0x82000000 0x0 0x60000000 0x6 0x20000000 0x0 0x80000000>,
				 <0x83000000 0x7 0x00000000 0x7 0x00000000 0x0 0x80000000>,
				 <0xC3000000 0x7 0x90000000 0x7 0x90000000 0x0 0x70000000>;
			dma-coherent;
			// iommus = <&mmu600_pcie 0x1000>;
			// iommu-map = <0x1000  &mmu600_pcie 0x1000 0x1000>;

			interrupt-parent = <&gic600>;
			interrupts =	<GIC_SPI 92 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 84 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 74 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 76 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 77 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 78 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 79 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 80 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "msi", "other", "dma0", "dma1", "dma2", "dma3", "dma4", "dma5", "dma6", "dma7";
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 0x7>;
			interrupt-map = <0 0 0 1 &pcie1_intc 0xF>,
					<0 0 0 2 &pcie1_intc 0xE>,
					<0 0 0 3 &pcie1_intc 0xD>,
					<0 0 0 4 &pcie1_intc 0xC>;
			pcie-phy = <&pcie_phy>;

			pcie1_intc: legacy-interrupt-controller {
				interrupt-controller;
				#address-cells = <0>;
				#interrupt-cells = <1>;
				interrupt-parent = <&gic600>;
				interrupts = <GIC_SPI 84 IRQ_TYPE_LEVEL_HIGH>;
			};
		};

		pcie1_ep:pcie1_ep@600000000 {
			status = "disable";
			compatible = "bst,dw-pcie-ep";
			controller-id = <1>;
			chip-type = <0x1>; /* 0x0=A1000 0x1=C1200 */
			reg =	<0x6 0x00000000 0 0x40000000>,
				<0x6 0x80000000 0 0x40000000>,
				<0x7 0x80000000 0 0x00040000>,
				<0x7 0x80080000 0 0x00040000>,
				<0x0 0x48000000 0 0x80000000>;
			reg-names = "dbi", "dbi2", "atu", "dma", "addr_space";
			dma-coherent;
			num-ib-windows = <16>;
			num-ob-windows = <16>;
			max-functions = /bits/ 8 <8>;
			max-virtual-functions = /bits/ 8 <4 4 0 0 0 0 0 0>;
			interrupt-parent = <&gic600>;
			interrupts =	<GIC_SPI 90 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 74 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 76 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 77 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 78 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 79 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 80 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "doorbell", "dma0", "dma1", "dma2", "dma3", "dma4", "dma5", "dma6", "dma7";

			pcie-phy = <&pcie_phy>;
		};

		// Media_system
		codec0:linlon-v5@0x24200000 {
			status = "disable";
			compatible = "arm china,linlon-v5";
			reg = <0 0x24200400 0 0x10000>;
			interrupt-parent = <&gic600>;
			interrupts = <0 276 4>;
		};

		codec1:linlon-v5@0x24300000 {
			status = "disable";
			compatible = "arm china,linlon-v5";
			reg = <0 0x24300400 0 0x10000>;
			interrupt-parent = <&gic600>;
			interrupts = <0 277 4>;
		};

		xrp0: xrp@0{
			#address-cells = <1>;
			#size-cells = <1>;
			compatible = "bst,xrp-hw-simple,v1";
			status = "okay";
			reg = <0x8 0x6400000 0x0 0x100000>,  /* shared mem*/
				<0x0 0x24d00000 0x0 0x00000200>; /* DSP MMIO */
			device-irq = <0 1 5>; /* offset, bit#, IRQ# */
			device-irq-host-offset = <0>;
			device-irq-mode = <0>;
			dma-coherent; /* smmu mask */
//			memory-region = <&bst_sramxrp_reserved>;
			host-irq = <0xfffff000 0>; /* offset, bit# */
			host-irq-mode = <0>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 141 IRQ_TYPE_LEVEL_HIGH>;
			firmware-name = "xrp0";
			ranges = < 0x80000000 0x0 0x80000000 0x500000>,
					<0x86400000 0x8 0x6400000 0x100000>,
					<0xA4ac0000 0x0 0x24ac0000 0x20000>,
					<0xA4ae0000 0x0 0x24ae0000 0x20000>;
			dsp@0 {
			};
		};

		vmac_hif_rx_setup: vmac-rx-queues-config {
			rx-queues-to-use = <1>;
		};

		vmac_hif_tx_setup: vmac-tx-queues-config {
			tx-queues-to-use = <1>;
		};

		vmac: ethernet@0x35000000 {
			status = "disable";
			compatible = "bst,vmac-hif";
			reg = <0x0 0x35000000 0 0xffffff>;
			hif-rx-config = <&vmac_hif_rx_setup>;
			hif-tx-config = <&vmac_hif_tx_setup>;
			ethernet-id = <0>;
		};
//************************Mipi CSITX Start *********************************************/

        csi_tx: csi_tx@0x24600000 {
                status = "disable";
                compatible = "bst,c1200_csi_tx";
                reg = <0x0 0x24600000 0 0x1000>,  //csi device
                      <0x0 0x24e01000 0 0x1000>,  //switch
                      <0x0 0x2460c000 0 0x4000>,  //dphy
                      <0x0 0x24e00000 0 0x1000>;  //media_dma
                lane-speed = <2500>;
                lane-num = <4>;
                vc-num = <4>;
		clocks= <&scmi_clk GATE_LB_MEDIA_DMA_ACLK_EN>, <&scmi_clk GATE_LB_MEDIA_DMA_HCLK_EN>;
		clock-names = "aclk","hclk";
		resets = <&scmi_reset RST_MEDIA_DMA_SW>;
		reset-names = "media_dma";
                interrupt-parent = <&gic600>;
                interrupts = <GIC_SPI 298 IRQ_TYPE_LEVEL_HIGH>;
                interrupt-names = "csi_dma";
        };

//************************Mipi CSITX End*********************************************/

		// ************************Native Display *********************************************/
		bst_dpu2:display@0x29000000 {
			status = "disable";
			compatible = "bst,c1200-native-display2";
			reg = <0x0 0x29000000 0 0x800000>,  // for C1200 Display2
				  <0x0 0x24F00000 0 0x100>,
				  <0x0 0x30230000 0 0x10000>;
			reg-names = "dpu-base","csr-base", "mdnoc-qos-base";
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 291 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <0>;
			assigned-clocks = <&scmi_clk PLL_DISPLAY_MUX4_1188_CLK_SEL >;
			assigned-clock-parents = <&scmi_clk CLK3_1188>;
			pipeline@0 {
				reg = <0>;
				clocks= <&scmi_clk PLL_CLK_DISPLAY3>,<&scmi_clk DIVIDOR_DISPLAY2_CH0>,<&scmi_clk GATE_LB_DISPLAY2_CH0_CLK_EN>,<&scmi_clk GATE_LB_DISPLAY2_ACLK_EN >,<&scmi_clk GATE_LB_DISPLAY2_PCLK_EN>,<&scmi_clk MUX_DISPLAY2_ACLK_SEL>;
				clock-names = "pll_clk","div_clk","gate_pixelclk","gate_aclk","gate_pclk","mux_aclk";

				port {
					#address-cells = <1>;
					#size-cells = <0>;
					dpu2_pipe0_link0_out: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&bst_dptx_host>;
					};
				};
			};
		};

		bst_dpu1:display@0x28800000 {
			status = "disable";
			compatible = "bst,c1200-native-display1";
			reg = <0x0 0x28800000 0 0x800000>,  // for C1200 Display1
				  <0x0 0x24F00000 0 0x100>,
				  <0x0 0x30230000 0 0x10000>;
			reg-names = "dpu-base","csr-base", "mdnoc-qos-base";
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 285 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <0>;
			assigned-clocks = <&scmi_clk PLL_DISPLAY_MUX2_1188_CLK_SEL >,<&scmi_clk PLL_DISPLAY_MUX3_1188_CLK_SEL >;
			assigned-clock-parents = <&scmi_clk CLK2_1188>,<&scmi_clk CLK2_1188>;
			pipeline@0 {
				reg = <0>;
				clocks= <&scmi_clk PLL_CLK_DISPLAY2>,<&scmi_clk DIVIDOR_DISPLAY1_CH0>,<&scmi_clk GATE_LB_DISPLAY1_CH0_CLK_EN>,<&scmi_clk GATE_LB_DISPLAY1_ACLK_EN >,<&scmi_clk GATE_LB_DISPLAY1_PCLK_EN>,<&scmi_clk MUX_DISPLAY1_ACLK_SEL>;
				clock-names = "pll_clk","div_clk","gate_pixelclk","gate_aclk","gate_pclk","mux_aclk";
				port {
					#address-cells = <1>;
					#size-cells = <0>;
					dpu1_pipe0_link0_out: endpoint@0 {
						reg = <0>;
						//remote-endpoint = <&bst_lvds_ch1_in>;
						remote-endpoint = <&bst_dsi1_host_in>;
					};
				};
			};
			pipeline@1 {
				reg = <1>;
				clocks= <&scmi_clk PLL_CLK_DISPLAY2>,<&scmi_clk DIVIDOR_DISPLAY1_CH1>,<&scmi_clk GATE_LB_DISPLAY1_CH1_CLK_EN>,<&scmi_clk GATE_LB_DISPLAY1_ACLK_EN >,<&scmi_clk GATE_LB_DISPLAY1_PCLK_EN>,<&scmi_clk MUX_DISPLAY1_ACLK_SEL>;
				clock-names = "pll_clk","div_clk","gate_pixelclk","gate_aclk","gate_pclk","mux_aclk";

				port {
					#address-cells = <1>;
					#size-cells = <0>;
					dpu1_pipe1_link0_out: endpoint@0 {
						reg = <0>;
						//remote-endpoint = <&bst_lvds_ch2_in>;
						remote-endpoint = <&bst_dsi0_host_in>;
					};
				};
			};
		};

		bst_dpu0:display@0x28000000  {
			compatible = "bst,c1200-native-display0";
			status = "disable";
			reg = <0x0 0x28000000 0 0x800000>,  // for C1200 Display0
				  <0x0 0x24F00000 0 0x100>,
				  <0x0 0x30230000 0 0x10000>;
			reg-names = "dpu-base","csr-base", "mdnoc-qos-base";
			interrupt-parent = <&gic600>;
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <GIC_SPI 283 IRQ_TYPE_LEVEL_HIGH>;
			assigned-clocks = <&scmi_clk PLL_DISPLAY_MUX0_1188_CLK_SEL >,<&scmi_clk PLL_DISPLAY_MUX1_1188_CLK_SEL>;
			assigned-clock-parents = <&scmi_clk CLK0_1188>,<&scmi_clk CLK1_1188>;
			pipeline@0 {
				reg = <0>;
				clocks= <&scmi_clk PLL_CLK_DISPLAY0>,<&scmi_clk DIVIDOR_DISPLAY0_CH0>,<&scmi_clk GATE_LB_DISPLAY0_CH0_CLK_EN>,<&scmi_clk GATE_LB_DISPLAY0_ACLK_EN >,<&scmi_clk GATE_LB_DISPLAY0_PCLK_EN >,<&scmi_clk MUX_DISPLAY0_ACLK_SEL >;
				clock-names = "pll_clk","div_clk","gate_pixelclk","gate_aclk","gate_pclk","mux_aclk";
				port {
					#address-cells = <1>;
					#size-cells = <0>;
					dpu0_pipe0_link0_out: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&bst_lvds_ch1_in>;
					};
				};
			};
			pipeline@1 {
				reg = <1>;
				clocks= <&scmi_clk PLL_CLK_DISPLAY1>,<&scmi_clk DIVIDOR_DISPLAY0_CH1>,<&scmi_clk GATE_LB_DISPLAY0_CH1_CLK_EN>,<&scmi_clk GATE_LB_DISPLAY0_ACLK_EN >,<&scmi_clk GATE_LB_DISPLAY0_PCLK_EN >,<&scmi_clk MUX_DISPLAY0_ACLK_SEL >;
				clock-names = "pll_clk","div_clk","gate_pixelclk","gate_aclk","gate_pclk","mux_aclk";
				port {
					#address-cells = <1>;
					#size-cells = <0>;
					dpu0_pipe1_link0_out: endpoint@0 {
						reg = <0>;
						// remote-endpoint = <&bst_vout_panel>;
					};
				};
			};
		};

		/* for VOUT_CONN EVM hardware version */
		vout_conn:vout_connector@0 {
			status = "okay";
			compatible = "bst,bst-vout-conn";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x0 0x24F00000 0x0 0x1000>;
			display-timings {
				timing_1920x1080p60 {
					clock-frequency = <148500000>;
					hactive = <1920>;
					vactive = <1080>;
					hsync-len = <0 44 60>;
					hfront-porch = <80 88 95>;
					hback-porch = <100 148 160>;
					vfront-porch = <0 4 6>;
					vback-porch = <0 36 50>;
					vsync-len = <0 5 6>;
				};
				timing_3840x2160p30 {
					clock-frequency = <297000000>;
					hactive = <3840>;
					vactive = <2160>;
					hsync-len = <0 88 120>;
					hfront-porch = <160 176 190>;
					hback-porch = <200 296 320>;
					vfront-porch = <0 8 12>;
					vback-porch = <0 72 100>;
					vsync-len = <0 10 12>;
				};
			};
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					bst_vout_panel: endpoint@0 {
						// remote-endpoint = <&dpu0_pipe1_link0_out>;
					};
				};
			};
		};


		bst-lvds-panel0 {
			compatible = "panel-lvds";
			rotation = <0>;
			label = "lvdspanel0";
			data-mapping = "vesa-24";//vesa-24 jeida-24
			width-mm = <1920>;
			height-mm = <720>;
			panel-timing {
				clock-frequency = <93600000>;
				hactive = <1920>;
				vactive = <720>;
				hfront-porch = <70>;
				hback-porch = <47>;
				hsync-len = <43>;
				vsync-len = <3>;
				vfront-porch = <3>;
				vback-porch = <24>;
				vsync-active = <0>;
				hsync-active = <0>;
			};
			port {
				lvds_panel:endpoint@0 {
					remote-endpoint = <&bst_lvds_ch1_out>;
				};
			};
		};

		bst-lvds-panel1 {
			compatible = "bst,lvds1-panel";
			rotation = <0>;
			label = "lvdspanel1";
			data-mapping = "vesa-24";//vesa-24 jeida-24
			width-mm = <1920>;
			height-mm = <720>;
			panel-timing {
				clock-frequency = <93600000>;
				hactive = <1920>;
				vactive = <720>;
				hfront-porch = <70>;
				hback-porch = <47>;
				hsync-len = <43>;
				vsync-len = <3>;
				vfront-porch = <3>;
				vback-porch = <24>;
				vsync-active = <0>;
				hsync-active = <0>;
			};
			port {
				lvds_panel1:endpoint@1 {
					remote-endpoint = <&bst_lvds_ch2_out>;
				};
			};
		};

		lvds_conn:lvds_conn@0x24F01000 {
			status = "disable";
			compatible = "bst,bst-lvds-conn";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x0 0x24F01000 0x0 0x1000>;
			assigned-clocks = <&scmi_clk CLK_LVDS0_HSPEED_1188 >,<&scmi_clk CLK_LVDS1_HSPEED_1188 >;
			assigned-clock-parents = <&scmi_clk CLK0_1188>,<&scmi_clk CLK1_1188>;
			lvds_channel@0{
				output = <1>;   /*0 invalid,1 o_channel,2 e_channel,3 dualchannel,lvds0 and lvds1 cannot select the same output channel*/
				data-mapping = "vesa-24";
				reg = <0>;
				ports {
				#address-cells = <1>;
				#size-cells = <0>;
					port@0 {
						reg = <0>;
						#address-cells = <1>;
						#size-cells = <0>;
						bst_lvds_ch1_out: endpoint@0 {
							reg = <0>;
							remote-endpoint = <&lvds_panel>;
						};
					};
					port@1 {
						reg = <1>;
						#address-cells = <1>;
						#size-cells = <0>;
						bst_lvds_ch1_in: endpoint@0 {
							reg = <0>;
							remote-endpoint = <&dpu0_pipe0_link0_out>;
						};
					};
				};
			};

			lvds_channel@1{
				output = <2>;//0 invalid,1 o_channel,2 e_channel,3 dualchannel,lvds0 and lvds1 cannot select the same output channel
				data-mapping = "vesa-24";
				reg = <1>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						bst_lvds_ch2_out: endpoint@0 {
							remote-endpoint = <&lvds_panel1>;
						};
					};
					port@1 {
						reg = <1>;
						bst_lvds_ch2_in: endpoint@0 {
							// remote-endpoint = <&dpu0_pipe1_link0_out>;
						};
					};
				};
			};
		};

		mipi_dsi0:dsi0@0x24608000 {
				status = "disable";
				compatible = "bst,bst-dsi";
				#address-cells = <0x1>;
				#size-cells = <0x0>;
				reg = <0x0 0x24608000 0 0x4000>;
				reg-names = "dsi-base";
				//dual-link;
				clocks= <&scmi_clk GATE_LB_DSI_PCLK_EN>;
				clock-names = "pclk";
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						bst_dsi0_host_in: endpoint@0 {
							remote-endpoint = <&dpu1_pipe1_link0_out>;
						};
					};
					port@1{
						reg = <1>;
						bst_dsi_output:endpoint@1 {
							remote-endpoint = <&dsi_panel>;
						};
					};
				};
				mipi_panel: panel@0 {
					compatible = "bst,boe_1920x1080";
					reg = <0>;
					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0 {
							reg = <0>;
							dsi_panel: endpoint@0 {
								remote-endpoint = <&bst_dsi_output>;
							};
						};
					};
				};
		};
		mipi_dsi1:dsi1@0x24604000 {
			status = "disable";
			compatible = "bst,bst-dsi";
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			reg =<0x0 0x24604000 0 0x4000>;
			reg-names = "dsi-base";
			clocks= <&scmi_clk GATE_LB_DSI_PCLK_EN>;
			clock-names = "pclk";
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						bst_dsi1_host_in: endpoint@0 {
							remote-endpoint = <&dpu1_pipe0_link0_out>;
						};
					};
					port@1{
						reg = <1>;
						bst_dsi1_output:endpoint@1 {
							remote-endpoint = <&dsi1_panel>;
						};
					};
				};
				mipi_panel1: panel@1 {
					compatible = "bst,panel_bst";
					reg = <1>;
					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@1 {
							reg = <1>;
							dsi1_panel: endpoint@1 {
								remote-endpoint = <&bst_dsi1_output>;
							};
						};
					};
				};
		};
		mipi_csr: mipi_csr@0x2460c000 {
			status = "disable";
			compatible = "bst,bst-mipi-csr", "syscon";
			reg = <0x0 0x2460c000 0 0x4000>;
		};

		bst_dptx: dptx@24C30000 {
			status = "disable";
			compatible = "bst,bst-dptx";
			reg = <0x0 0x24C30000 0x0 0x10000>,	// EDP CORE
				  <0x0 0x24C10000 0x0 0x10000>,	// EDP CSR
				  <0x0 0x2002C000 0x0 0x1000>;	// SOC_LSP1 I2S3_out->eDP_in
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 300 IRQ_TYPE_LEVEL_HIGH>;
			/* lane-speed = 1620(RBR)/2700(HBR)/5400(HBR2)/8100(HBR3) */
			lane-speed = <5400>;    // 1620/2700/5400/8100
			lane-num = <4>;         // 1/2/4 lane(s)
			colorimetry = <1>;		// 1-ITU601, 2-ITU709
			dynamic-range = <1>;	// 1-CEA, 2-VESA
			video-bpc = <8>;        // 6/8/10/12/16 bit
			pixel-encode = <0>;	// 0-RGB,1-YCBCR420,2-YCBCR422,3-YCBCR444,4-YONLY,5-RAW
			dp-interface = <0>;     // 0-DP,1-eDP
			force-hpd = <1>;        // 0-no force,1-force
			ssc-enable = <0>;       // 0-disable, 1-enable
			bypass-training = <0>;  // 0-training,1-bypass training
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				dptx_in: port@0 {
					reg = <0>;
					bst_dptx_host: endpoint@0 {
						remote-endpoint = <&dpu2_pipe0_link0_out>;
					};
				};
				dptx_out: port@1 {
					reg = <1>;
					dptx_out_to_panel: endpoint@0 {
						remote-endpoint = <&dp_panel_in>;
					};
				};
			};
		};

		dp_panel:bst-dp-panel {
			compatible = "bst,dp-panel";
			status = "disable";
			rotation = <0>;
			no-hpd;
			// is_edp; /* edp panel type, need config dp-interface = <1> */
			panel-timing {
				/* 1920x1080 - Common*/
				// clock-frequency = <148500000>;
				// hactive = <1920>;
				// vactive = <1080>;
				// hfront-porch = <88>;
				// hback-porch = <148>;
				// hsync-len = <44>;
				// vsync-len = <5>;
				// vfront-porch = <4>;
				// vback-porch = <36>;
				// vsync-active = <0>;
				// hsync-active = <0>;

				/* 4032x756 - Bringup*/
				// clock-frequency = <198300000>;
				// hactive = <4032>;
				// vactive = <756>;
				// hfront-porch = <72>;
				// hback-porch = <72>;
				// hsync-len = <72>;
				// vsync-len = <2>;
				// vfront-porch = <12>;
				// vback-porch = <8>;
				// vsync-active = <0>;
				// hsync-active = <1>;

				/* 1920x720 - CES */
				// clock-frequency = <93600000>;
				// hactive = <1920>;
				// vactive = <720>;
				// hfront-porch = <70>;
				// hback-porch = <47>;
