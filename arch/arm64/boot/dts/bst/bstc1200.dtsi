//************************Native Display End*********************************************/

//************************Virtual Display Start******************************************/
		bst_disp_fw_msgbx: display_firmware@0 {
			compatible = "bst,bst-display-firmware-msgbx";
			status = "disable";
		};
		bst_disp_fw_ipc: display_firmware@1 {
			compatible = "bst,bst-display-firmware-ipc";
			status = "disable";
		};

		bst_virt_dpu0: bst_virt_dpu@0 {
			compatible = "bst,c1200-virtual-display0";
			status = "disable";
			#address-cells = <1>;
			#size-cells = <0>;
			os-type = "ADAS"; /* "ADAS", "DB", "IVI" */
			pipeline@0 {
				status = "disable";
				reg = <0>;
				layer-num = <4>;
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					#address-cells = <1>;
					#size-cells = <0>;
					virt_pipe0_out: endpoint@0 {
						reg = <0>;
						//remote-endpoint = <&virt_dptx_in>;
					};
				};
			};

			pipeline@1 {
				status = "disable";
				reg = <1>;
				layer-num = <2>;
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
					virt_pipe1_out: endpoint@0 {
						reg = <0>;
						//remote-endpoint = <&virt_dsi0_in>;
					};
				};
			};

			pipeline@2 {
				status = "disable";
				reg = <2>;
				layer-num = <1>;
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
					virt_pipe2_out: endpoint@0 {
						reg = <0>;
						//remote-endpoint = <&virt_dsi1_in>;
					};
				};
			};

			pipeline@3 {
				status = "disable";
				reg = <3>;
				layer-num = <1>;
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
					virt_pipe3_out: endpoint@0 {
						reg = <0>;
						//remote-endpoint = <&virt_lvds1_in>;
					};
				};
			};
			pipeline@4 {
				status = "disable";
				reg = <4>;
				layer-num = <1>;
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
					virt_pipe4_out: endpoint@0 {
						reg = <0>;
						//remote-endpoint = <&virt_lvds0_in>;
					};
				};
			};
		};

		bst_virt_dptx: bst-virt-conn@0 {
			compatible = "bst,virt-dp";
			status = "disable";
			#address-cells = <1>;
			#size-cells = <0>;
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
					virt_dptx_in: endpoint@0 {
						reg = <0>;
						// remote-endpoint = <&virt_pipe0_out>;
					};
				};
			};
		};

		bst_virt_lvds0: bst-virt-conn@1 {
			compatible = "bst,virt-lvds0";
			status = "disable";
			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
					virt_lvds0_in: endpoint@0 {
						reg = <0>;
						//remote-endpoint = <&virt_pipe0_out>;
					};
				};
			};
		};

		bst_virt_lvds1: bst-virt-conn@2 {
			compatible = "bst,virt-lvds1";
			status = "disable";
			#address-cells = <1>;
			#size-cells = <0>;
			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
					virt_lvds1_in: endpoint@0 {
						reg = <0>;
						//remote-endpoint = <&virt_pipe3_out>;
					};
				};
			};
		};

		bst_virt_dsi0: bst-virt-conn@3 {
			compatible = "bst,virt-dsi0";
			status = "disable";
			#address-cells = <1>;
			#size-cells = <0>;
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
					virt_dsi0_in: endpoint@0 {
						reg = <0>;
						//remote-endpoint = <&virt_pipe1_out>;
					};
				};
			};
		};
		bst_virt_dsi1: bst-virt-conn@4 {
			compatible = "bst,virt-dsi1";
			status = "disable";
			#address-cells = <1>;
			#size-cells = <0>;
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
					virt_dsi1_in: endpoint@0 {
						reg = <0>;
						//remote-endpoint = <&virt_pipe2_out>;
					};
				};
			};
		};
//************************Virt Display End*********************************************/

		gpu_ivi:gpu@0x26100000 {
			status = "disable";
			compatible = "arm,mali-midgard";
			reg = < 0x0 0x26100000 0x0 0x4000>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "JOB", "MMU", "GPU";
			resets = <&scmi_reset RST_GPU_G78AE_SW>;
			reset-names = "g78ae_mp_reset";
			physical-memory-group-manager = <&gpu_physical_memory_group_manager>;
		};

		gpu_adas:gpu@0x260e0000 {
			status = "disable";
			compatible = "arm,mali-midgard";
			reg = < 0x0 0x260e0000 0x0 0x4000>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "JOB", "MMU", "GPU";
			resets = <&scmi_reset RST_GPU_G78AE_SW>;
			reset-names = "g78ae_mp_reset";
			physical-memory-group-manager = <&gpu_physical_memory_group_manager>;
		};

		gpu_db:gpu@0x344e0000 {
			status = "disable";
			compatible = "arm,mali-midgard";
			reg = <0x0 0x344e0000 0 0x4000>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 153 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 153 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 153 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "JOB", "MMU", "GPU";
			resets = <&scmi_reset RST_GPU_G78AE_SP_SW>;
			reset-names = "g78ae_sp_reset";
			physical-memory-group-manager = <&gpu_physical_memory_group_manager>;
		};

		gpu_physical_memory_group_manager: physical-memory-group-manager {
			compatible = "arm,physical-memory-group-manager";
		};

		gpu_dma_buf:dma_exporter@0 {
			compatible = "bst,g78_dma_buf";
		};

		// CFG_SOC_SYS
		// sysctrl 3000:0000

		pinctrl: pinctrl@30001000 {
			status = "disable";
			compatible = "bst,pinctrl-c1200";
			#address-cells = <2>;
			#size-cells = <2>;
			reg = <0x0 0x64034000 0x0 0x1000>,
					<0x0 0x30001000 0x0 0x1000>;
			reg-names = "aon", "top";
			#gpio-cells = <2>;

		};

		clkc:c1200bclkc@30002000 {
			status = "disable";
			compatible = "bst,c1200-clkc";
			#clock-cells = <0x1>;
			osc-clk-frequency = <25000000>;
			reg = <	0x0 0x30002000 0x0 0x1000>;	/* TOP_CRM_REG */
		};

		gtc:bstgtc@3000a000 {
			status = "disable";
			compatible = "bst,bst-gtc";
			reg = <0x0 0x3000A000 0x0 0x1000>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 126 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "gtc_irq";
			mux_idx = <8>;
		};

		// cpu subsystem csr 3000:3000
		// soc probe 3000:4000
		// timestamp_csr 3000:8000
		// ipc 3010:0000
		// noc 3020:0000 ~~ 3028:0000
		// coresight_ATB 3030:0000
		// soc_dma_hs 3100:0000 ~~ 3125:0000
		// CFG_SOC_CPU 3200:0000 ~~ 3230:0000

		xgmac_axi_setup: stmmac-axi-config {
			snps,wr_osr_lmt = <0x1f>;
			snps,rd_osr_lmt = <0x1f>;
			snps,axi_fb;
			snps,blen = <4 8 16 32 64 128 256>;
		};

		xgmac_mtl_rx_setup: mtl_rx-queues-config {
			snps,rx-queues-to-use = <4>;
			snps,rx-sched-sp;
			queue0 {
				snps,dcb-algorithm;
				snps,map-to-dma-channel = <0x0>;
				// snps,priority = <0x0>;
			};
			queue1 {
				snps,dcb-algorithm;
				snps,route-up;
				snps,map-to-dma-channel = <0x1>;
				// snps,priority = <0x1>;
			};
			queue2 {
				snps,dcb-algorithm;
				snps,route-ptp;
				snps,map-to-dma-channel = <0x2>;
				// snps,priority = <0x2>;
			};
			queue3 {
				snps,dcb-algorithm;
				snps,route-multi-broad;
				snps,map-to-dma-channel = <0x3>;
				// snps,priority = <0x3>;
			};

		};

		xgmac_mtl_tx_setup: mtl_tx-queues-config {
			snps,tx-queues-to-use = <4>;
			snps,tx-sched-wrr;
			queue0 {
				snps,weight = <0x10>;
				snps,dcb-algorithm;
				snps,priority = <0x0>;
			};
			queue1 {
				snps,weight = <0x10>;
				snps,dcb-algorithm;
				snps,priority = <0x1>;
			};
			queue2 {
				snps,weight = <0x10>;
				snps,dcb-algorithm;
				snps,priority = <0x2>;
			};
			queue3 {
				snps,weight = <0x10>;
				snps,dcb-algorithm;
				snps,priority = <0x3>;
			};

		};
		xgmac0: ethernet@32400000 {
			status = "disable";
			eth-name = "xgmac0";
			compatible = "bst,dwxgmac";
			reg = <0x0 0x32400000 0 0x10000>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 150 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)
					GIC_SPI 151  (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)
					GIC_SPI 152  (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)
					GIC_SPI 153  (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)
					GIC_SPI 154  (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)
					GIC_SPI 155  (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)
					GIC_SPI 156  (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)
					GIC_SPI 157  (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)
					GIC_SPI 162  (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)
					GIC_SPI 163  (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)
					GIC_SPI 164  (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)
					GIC_SPI 165  (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)
					GIC_SPI 170  (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)
					GIC_SPI 171  (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)>;
			interrupt-names = "eth_lpi","sbd_irq", "sfty_ce_irq", "sfty_ue_irq","tx_chan0_irq","tx_chan1_irq","tx_chan2_irq","tx_chan3_irq",
					"rx_chan0_irq","rx_chan1_irq","rx_chan2_irq","rx_chan3_irq","wdata_ucerr_irq","paddr_parity_irq";
			ethernet-id = <0>;
			max-speed = <10000>;
			snps,multicast-filter-bins = <256>;
			snps,perfect-filter-entries = <128>;
			rx-fifo-depth = <16384>;
			tx-fifo-depth = <16384>;
			bst,fix-safety = <0>;
			bst,dma_int_mode = <1>;
			snps,fixed-burst;
			snps,force_sf_dma_mode;
			snps,axi-config = <&xgmac_axi_setup>;
			snps,mtl-rx-config = <&xgmac_mtl_rx_setup>;
			snps,mtl-tx-config = <&xgmac_mtl_tx_setup>;
			label = "xgmac0";
		};

		cooling_dev {
			pwm: pwm {
				cpumask = <0xf>;
				capacitance = <1500>;
				#cooling-cells = <2>;
			};
		};

		thermal-zones {
			cpu_thermal: cpu-thermal {
				polling-delay-passive = <500>;
				polling-delay = <0>;
				thermal-sensors = <&thermal>;

				trips {
					trip0: switch_trip {
						temperature	= <90000>;
						hysteresis	= <2000>;
						type		= "passive";
					};
					crit: critical_trip {
						temperature	= <125000>;
						hysteresis	= <0>;
						type		= "critical";
					};
				};

				cooling-maps {
					map0 {
						trip = <&trip0>;
						cooling-device = <&pwm 0 3>;
					};
				};
			};
		};


		gic600: interrupt-controller@0 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <3>;
			#address-cells = <2>;
			#size-cells = <2>;
			interrupt-controller;
			ranges;
			reg = <0x0 0x32800000 0 0x10000>,	// GICD
				<0x0 0x32880000 0 0x100000>;	// GICR
			interrupt-parent = <&gic600>;
			interrupts = <GIC_PPI 0x9 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)>;

			its0_x4: gic-its@32840000 {
				status = "disable";
				compatible = "arm,gic-v3-its";
				msi-controller;
				#msi-cells = <1>;
				reg = <0x0 0x32840000 0x0 0x20000>;
			};

			its1_x2: gic-its@32860000 {
				status = "disable";
				compatible = "arm,gic-v3-its";
				msi-controller;
				#msi-cells = <1>;
				reg = <0x0 0x32860000 0x0 0x20000>;
			};
		};

		cv_bus: cv_bus {
			#address-cells = <2>;
			#size-cells = <2>;
			compatible = "simple-bus";
			ranges;

			bst_cvsmm: bst-cvsmm {
				#address-cells = <2>;
				#size-cells = <2>;
				status = "disabled";
				compatible = "bst,bst-cvsmm";
			};
		};

		hwcv: bst-hwcv@0x51000000 {
			status = "disabled";
			#address-cells = <2>;
			#size-cells = <2>;
			compatible = "bst,c1200-hwcv";
			reg = <0x0 0x51000000 0x0 0x100>, //CV base
			      <0x0 0x51020000 0x0 0x78>,  //Scaler base
			      <0x0 0x51021000 0x0 0x548>, //Gwarp0 base
			      <0x0 0x51022000 0x0 0x548>; //Gwarp1 base
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 360 (IRQ_TYPE_LEVEL_HIGH)>;
			interrupt-names = "bst-hwcv-irq";
		};

		ipc: bst-ipc {
			status = "disable";
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			compatible = "bst,bst-ipc";
			reg =   <0x0 0x30102000 0x0 0x2000>,
					<0x0 0x30100000 0x0 0x2000>;
			assigned-mem-size = <0x1000>;
		};

		mbox: bst-mbox {
			status = "disable";
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			compatible = "bst,bst-mbox";
			reg =   <0x0 0x30102000 0x0 0x2000>,
					<0x0 0x30100000 0x0 0x2000>;
			assigned-mem-size = <0x1000>;
			ipc-cpus = <2 3>;
			interrupt-parent = <&gic600>;
			interrupts = <
						GIC_SPI 109 (IRQ_TYPE_LEVEL_HIGH)
						GIC_SPI 110 (IRQ_TYPE_LEVEL_HIGH)
						GIC_SPI 111 (IRQ_TYPE_LEVEL_HIGH)
						GIC_SPI 112 (IRQ_TYPE_LEVEL_HIGH)
						GIC_SPI 176 (IRQ_TYPE_LEVEL_HIGH)
						GIC_SPI 177 (IRQ_TYPE_LEVEL_HIGH)>;
		};

		bstnpu: bst-npu@50020000 {
			compatible = "bst,c1200-bstnpu";
			reg = <0x0 0x50020000 0x0 0x100>,
						<0x8 0x10000000 0x0 0x2000000>;
			/* for summu to bypass physical address. */
			bypass_res = <0x0 0x30000000 0x0 0x01000000>,
									<0x0 0x50000000 0x0 0x10000000>,
									<0x8 0x20000000 0x0 0x01000000>;
			status = "disabled";

			npu0@810000000 {
				/* <sreg fw_reg> */
				reg-idx = <0x0 0x1>;
				firmware = "bstn_dsp_rtos.rbf";
				firmware-msgbx = "bstn_dsp_rtos.msgbox.rbf";
				msgbox-pid = <0x17>;
				msgbox-cid = <0x40>;
				msgbox-sid = <0xa>;
				ipc-pid = <0x00>;
				ipc-cid = <0x14>;
			};
		};

		bstdsp: bst-dsp@51000000 {
			compatible = "bst,c1200-bstdsp";
			reg = <0x0 0x51000000 0x0 0x100>,
					<0x8 0x16000000 0x0 0x2000000>,
					<0x8 0x18000000 0x0 0x2000000>,
					<0x8 0x12000000 0x0 0x2000000>,
					<0x8 0x14000000 0x0 0x2000000>;
			/* for summu to bypass physical address. */
			bypass_res = <0x0 0x30000000 0x0 0x01000000>,
									<0x0 0x47000000 0x0 0x01000000>,
									<0x0 0x50000000 0x0 0x10000000>,
									<0x8 0x3e000000 0x0 0x02000000>,
									<0x8 0x00300000 0x0 0x00400000>;
			ipc-reg-addr = <0x8 0x00300000 0x0 0x00400000>;
			status = "disabled";

			dsp0@816000000 {
				reg-idx = <0x0 0x1>;
				firmware = "bst_dsp_rpc_fw0.rbf";
				firmware-msgbx = "bst_dsp_rpc_fw0.rbf";
				firmware-rtinit-offset = <0x007ff000>;
				msgbox-pid = <0x16>;
				msgbox-cid = <0x30>;
				msgbox-sid = <0xb>;
				ipc-pid = <0x03>;
				ipc-cid = <0x10>;
			};

			dsp1@818000000 {
				reg-idx = <0x0 0x2>;
				firmware = "bst_dsp_rpc_fw1.rbf";
				firmware-msgbx = "bst_dsp_rpc_fw1.rbf";
				firmware-rtinit-offset = <0x007ff000>;
				msgbox-pid = <0x16>;
				msgbox-cid = <0x31>;
				msgbox-sid = <0xc>;
				ipc-pid = <0x03>;
				ipc-cid = <0x11>;
			};

			dsp2@812000000 {
				reg-idx = <0x0 0x3>;
				firmware = "bst_dsp_rpc_fw2.rbf";
				firmware-msgbx = "bst_dsp_rpc_fw2.rbf";
				firmware-rtinit-offset = <0x007ff000>;
				msgbox-pid = <0x16>;
				msgbox-cid = <0x32>;
				msgbox-sid = <0xd>;
				ipc-pid = <0x03>;
				ipc-cid = <0x12>;
			};

			dsp3@814000000 {
				reg-idx = <0x0 0x4>;
				firmware = "bst_dsp_rpc_fw3.rbf";
				firmware-msgbx = "bst_dsp_rpc_fw3.rbf";
				firmware-rtinit-offset = <0x007ff000>;
				msgbox-pid = <0x16>;
				msgbox-cid = <0x33>;
				msgbox-sid = <0xe>;
				ipc-pid = <0x03>;
				ipc-cid = <0x13>;
			};
		};

                bstn_bus: bstn_bus {
                        #address-cells = <2>;
                        #size-cells = <2>;
                        compatible = "simple-bus";
                        ranges;
                        bstn: bstn@50020000 {
                                #address-cells = <2>;
                                #size-cells = <2>;
                                status = "disable";
                                compatible = "bst,bstn";
                                id = <0x0>;
                                reg = <0x0 0x50020000 0x0 0x100
                                       0x8 0x10000000 0x0 0x2000000>;
                                assigned-mem-size = <0x1000>;
                                rmem-base = <0xc 0x00000000>;
                                rmem-size = <0x0 0x40000000>;
                                bus-offset = <0x0 0x0>;
                                firmware = "bstn_dsp_rtos.rbf";
                                firmware1 = "bstn_dsp_rtos.msgbox.rbf";
                                msgbox-endid = <0x17>; /* CPU_7 */
                                ipc-src-core = <0x2>;
                        };
                };

		lwnn: bst_lwnn@51000000 {
			status = "disable";
			compatible = "bst,bst_lwnn,cma";
			reg = <0x0 0x51000000 0x0 0x100
					0x8 0x12000000 0x0 0x2000000
					0x8 0x14000000 0x0 0x2000000
					0x8 0x16000000 0x0 0x2000000
					0x8 0x18000000 0x0 0x2000000>;
			bus-offset = <0x0 0x0>;
			dsp-num = <0x4>;
			ipc-register-addr = <0x8ff00000>;
			msgbox-endid = <0x16>; /* CPU_6 */

			dsp@812000000 {
				index = <0x2>;
				firmware = "bst_lwnn_dsp2_rt.rbf";
				firmware1 = "bst_lwnn_dsp2_rt.msgbox.rbf";
				assigned-mem-size = <0x2000>;
				/* old:0x9000 0000, offset: 0x027ff000 */
				/* new:0x6140 0000 + offset: 0x027ff000,  */
				rt-init-addr = <0x63bff000>;
				ipc-src-core = <0x0>;
			};
			dsp@814000000 {
				index = <0x3>;
				firmware = "bst_lwnn_dsp3_rt.rbf";
				firmware1 = "bst_lwnn_dsp3_rt.msgbox.rbf";
				assigned-mem-size = <0x2000>;
				rt-init-addr = <0x65bff000>;
				ipc-src-core = <0x3>;
			};
			dsp@816000000 {
				index = <0x0>;
				firmware = "bst_lwnn_dsp0_rt.rbf";
				firmware1 = "bst_lwnn_dsp0_rt.msgbox.rbf";
				assigned-mem-size = <0x2000>;
				rt-init-addr = <0x67bff000>;
				ipc-src-core = <0x0>;
			};
			dsp@818000000 {
				index = <0x1>;
				firmware = "bst_lwnn_dsp1_rt.rbf";
				firmware1 = "bst_lwnn_dsp1_rt.msgbox.rbf";
				assigned-mem-size = <0x2000>;
				rt-init-addr = <0x69bff000>;
				ipc-src-core = <0x1>;
			};
		};

		// CFG_DB_CPU 33000000 ~~ 3330:0000
		// gic 33200000
		// msgbox 0x33300000
		// DB_SUBSYSTEM 3400:0000 ~~ 3480:0000  include dma、gpu


		// coreip 5000:0000 ~~ 5FFF:FFFF  include net、cv、isp、mipi、coreip_mem
		// cmn 0:6000:0000	0:63FF:FFFF
		// DDR_CTRL	0:7000:0000

		arm_pmu: arm_pmu {   // menuconfig PERF_EVENTS
		status = "disable";
		compatible = "arm,armv8-pmuv3";
		interrupt-parent = <&gic600>;
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_HIGH>;
		};

		gmac_axi_setup: axi-config {
			snps,wr_osr_lmt = <0xf>;
			snps,rd_osr_lmt = <0xf>;
			snps,axi_fb;
			snps,blen = <4 8 16 0 0 0 0>;
		};
		gmac_mtl_rx_setup: rx-queues-config {
			snps,rx-queues-to-use = <4>;
			snps,rx-sched-sp;
			queue0 {
				snps,dcb-algorithm;
				snps,map-to-dma-channel = <0x0>;
				snps,priority = <0x0>;
			};
			queue1 {
				snps,dcb-algorithm;
				snps,map-to-dma-channel = <0x1>;
				snps,priority = <0x1>;
			};
			queue2 {
				snps,dcb-algorithm;
				snps,map-to-dma-channel = <0x2>;
				snps,priority = <0x2>;
			};
			queue3 {
				snps,dcb-algorithm;
				snps,map-to-dma-channel = <0x3>;
				snps,priority = <0x3>;
			};
		};

		gmac_mtl_tx_setup: tx-queues-config {
			snps,tx-queues-to-use = <4>;
			snps,tx-sched-wrr;
			queue0 {
				snps,weight = <0x10>;
				snps,dcb-algorithm;
				snps,priority = <0x0>;
			};

			queue1 {
				snps,weight = <0x10>;
				snps,dcb-algorithm;
				snps,priority = <0x1>;
			};
			queue2 {
				snps,weight = <0x10>;
				snps,dcb-algorithm;
				snps,priority = <0x2>;
			};
			queue3 {
				snps,weight = <0x10>;
				snps,dcb-algorithm;
				snps,priority = <0x3>;
			};
		};
		gmac0: ethernet@217b8000 {
			status = "disable";
			compatible = "bst,sw-gmac";
			reg = <0x0 0x217b8000 0 0x8000>;
			interrupt-parent = <&gic600>;
			//sw_to_soc
			interrupts = <GIC_SPI 488  (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
							GIC_SPI 489  (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
							GIC_SPI 490  (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
							GIC_SPI 491  (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
							GIC_SPI 492  (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
							GIC_SPI 493  (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
							GIC_SPI 494  (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
							GIC_SPI 495  (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
							GIC_SPI 496  (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
							GIC_SPI 497  (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
							GIC_SPI 498  (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)>;
			interrupt-names = "sbd_irq", "rx_chan0_irq","rx_chan1_irq","rx_chan2_irq","rx_chan3_irq",
								"tx_chan0_irq","tx_chan1_irq","tx_chan2_irq","tx_chan3_irq",
								"sfty_ue_irq", "sfty_ce_irq";
			ethernet-id = <0>;
			max-speed = <1000>;
			snps,multicast-filter-bins = <256>;
			snps,perfect-filter-entries = <128>;
			rx-fifo-depth = <8192>;
			tx-fifo-depth = <8192>;
			bst,fix-safety = <0>;
			bst,dma_int_mode = <1>;
			snps,fixed-burst;
			snps,force_sf_dma_mode;
			//snps,force_thresh_dma_mode;
			snps,ps-speed = <1000>;
			snps,axi-config = <&gmac_axi_setup>;
			snps,mtl-rx-config = <&gmac_mtl_rx_setup>;
			snps,mtl-tx-config = <&gmac_mtl_tx_setup>;
			label = "gmac0";
		};

		virtouch: virt-touchscreen {
			status = "disable";
			compatible = "bst,virt-ts";
		};

		sqbuffer: sq-buffer {
			status = "disable";
			compatible = "bst,sqbuffer";
		};

		backlight_lvds0: bst_backlight@0 {
			status = "disable";
			compatible = "bst,virt-backlight";
			screen-id = <0x0>;
			//default-brightness-level = <50>;    /* Default brightness (optional), uses max_brightness/2 if not set */
		};
		backlight_lvds1: bst_backlight@1 {
			status = "disable";
			compatible = "bst,virt-backlight";
			screen-id = <0x1>;
		};
		backlight_dsi0: bst_backlight@2 {
			status = "disable";
			compatible = "bst,virt-backlight";
			screen-id = <0x2>;
		};
		backlight_dsi1: bst_backlight@3 {
			status = "disable";
			compatible = "bst,virt-backlight";
			screen-id = <0x3>;
		};
		backlight_edp: bst_backlight@4 {
			status = "disable";
			compatible = "bst,virt-backlight";
			screen-id = <0x4>;
		};
	};

	isp_bus: isp-bus@0 {
		compatible = "simple-bus";
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;

		/* This default dma-ranges is used for no-SMMU scene */
		dma-ranges = <0x0 0xC0000000 0xC 0x00000000 0x0 0x3E000000>,	// High 1G-32M RAM
			     <0x0 0x80000000 0x8 0x00000000 0x0 0x3E000000>,	// Low 1G-32M RAM
			     <0x0 0x3E000000 0x0 0x3E000000 0x0 0x02000000>,	// Reserved to restrict IOVA area
			     <0x0 0x40000000 0x0 0x20000000 0x0 0x07000000>,	// Outer registers area
			     <0x0 0x47000000 0x0 0x30000000 0x0 0x01000000>,	// Outer registers area
			     <0x0 0x50000000 0x0 0x50000000 0x0 0x10000000>;	// ISPCV inner registers

		i2cq0: i2cq@5203e000 {
			compatible = "bst,c1200-i2cq";
			reg = <0x0 0x5203e000 0 0x800>, // I2CQ base
			      <0x0 0x52030000 0 0x100>; // Top Ctrl
			clock-frequency = <937500>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 380 IRQ_TYPE_LEVEL_HIGH>;
			resets = <&scmi_reset RST_ISP_SW>;
			reset-names = "i2cq-reset";
			i2c-nr = <9>;
			#address-cells = <1>;
			#size-cells = <0>;
			id = <0>;
			status = "disabled";
		};

		i2cq1: i2cq@5203e800 {
			compatible = "bst,c1200-i2cq";
			reg = <0x0 0x5203e800 0 0x800>, // I2CQ base
			      <0x0 0x52030000 0 0x100>; // Top Ctrl
			clock-frequency = <937500>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 381 IRQ_TYPE_LEVEL_HIGH>;
			resets = <&scmi_reset RST_ISP_SW>;
			reset-names = "i2cq-reset";
			i2c-nr = <10>;
			#address-cells = <1>;
			#size-cells = <0>;
			id = <1>;
			status = "disabled";
		};

		i2cq2: i2cq@5203f000 {
			compatible = "bst,c1200-i2cq";
			reg = <0x0 0x5203f000 0 0x800>, // I2CQ base
			      <0x0 0x52030000 0 0x100>; // Top Ctrl
			clock-frequency = <937500>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 382 IRQ_TYPE_LEVEL_HIGH>;
			resets = <&scmi_reset RST_ISP_SW>;
			reset-names = "i2cq-reset";
			i2c-nr = <8>;
			#address-cells = <1>;
			#size-cells = <0>;
			id = <2>;
			status = "disabled";
		};

		csi0: csi@53000000 {
			compatible = "bst,c1200-csi2-rx";
			reg = <0x0 0x53000000 0x0 0x00015500>,
			      <0x0 0x53015500 0x0 0x00000100>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 361 (IRQ_TYPE_LEVEL_HIGH)>,
				     <GIC_SPI 362 (IRQ_TYPE_LEVEL_HIGH)>;
			resets = <&scmi_reset RST_MIPI0_CSIRX_SW>;
			reset-names = "csi-reset";
			clock-lanes = <0>;
			data-lanes = <1 2 3 4>;
			lane-speed = <2500>;
			id = <0>;
			status = "disabled";

			rx-ports {
				port@0 {
					csi0_in: endpoint@0{
					};
				};
			};
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					csi0_out0: endpoint@0 {
					};
				};
				port@1 {
					reg = <1>;
					csi0_out1: endpoint@1 {
					};
				};
				port@2 {
					reg = <2>;
					csi0_out2: endpoint@2 {
					};
				};
				port@3 {
					reg = <3>;
					csi0_out3: endpoint@3 {
					};
				};
			};
		};

		csi1: csi@53100000 {
			compatible = "bst,c1200-csi2-rx";
			reg = <0x0 0x53100000 0x0 0x00015500>,
			      <0x0 0x53115500 0x0 0x00000100>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 363 (IRQ_TYPE_LEVEL_HIGH)>,
				     <GIC_SPI 364 (IRQ_TYPE_LEVEL_HIGH)>;
			resets = <&scmi_reset RST_MIPI1_CSIRX_SW>;
			reset-names = "csi-reset";
			clock-lanes = <0>;
			data-lanes = <1 2 3 4>;
			lane-speed = <2500>;
			id = <1>;
			status = "disabled";

			rx-ports {
				port@0 {
					csi1_in: endpoint@0{
					};
				};
			};
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					csi1_out0: endpoint@0 {
					};
				};
				port@1 {
					reg = <1>;
					csi1_out1: endpoint@1 {
					};
				};
				port@2 {
					reg = <2>;
					csi1_out2: endpoint@2 {
					};
				};
				port@3 {
					reg = <3>;
					csi1_out3: endpoint@3 {
					};
				};
			};
		};

		csi2: csi@53200000 {
			compatible = "bst,c1200-csi2-rx";
			reg = <0x0 0x53200000 0x0 0x00015500>,
			      <0x0 0x53215500 0x0 0x00000100>;
			interrupt-parent = <&gic600>;
			interrupts = <GIC_SPI 365 (IRQ_TYPE_LEVEL_HIGH)>,
				     <GIC_SPI 366 (IRQ_TYPE_LEVEL_HIGH)>;
			resets = <&scmi_reset RST_MIPI2_CSIRX_SW>;
			reset-names = "csi-reset";
			clock-lanes = <0>;
			data-lanes = <1 2 3 4>;
			lane-speed = <2500>;
			id = <2>;
			status = "disabled";

			rx-ports {
				port@0 {
					csi2_in: endpoint@0{
					};
				};
			};
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
					reg = <0>;
					csi2_out0: endpoint@0 {
					};
				};
				port@1 {
					reg = <1>;
					csi2_out1: endpoint@1 {
					};
				};
				port@2 {
					reg = <2>;
					csi2_out2: endpoint@2 {
					};
				};
				port@3 {
					reg = <3>;
					csi2_out3: endpoint@3 {
					};
				};
			};
		};

		isp: isp@52030000 {
			compatible = "bst,c1200-isp";
			reg = <0x0 0x52030000 0 0x1000>,	// Top Ctrl
			      <0x0 0x52040000 0 0x40000>,	// PRAM
			      <0x0 0x47000000 0 0x01000000>,	// GTC, IPC, etc
			      <0x0 0x40000000 0 0x07000000>;	// I2C controller, etc
			resets = <&scmi_reset RST_ISP_SW>;
			reset-names = "isp-reset";
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					isp_chn0: endpoint@0 {
					};
				};
				port@1 {
					reg = <1>;
					isp_chn1: endpoint@1 {
					};
				};
				port@2 {
					reg = <2>;
					isp_chn2: endpoint@2 {
					};
				};
				port@3 {
					reg = <3>;
					isp_chn3: endpoint@3 {
					};
				};
				port@4 {
					reg = <4>;
						isp_chn4: endpoint@4 {
						};
					};
				port@5 {
					reg = <5>;
						isp_chn5: endpoint@5 {
						};
					};
				port@6 {
					reg = <6>;
						isp_chn6: endpoint@6 {
						};
					};
				port@7 {
					reg = <7>;
						isp_chn7: endpoint@7 {
					};
				};
				port@8 {
					reg = <8>;
					isp_chn8: endpoint@8 {
					};
				};
				port@9 {
					reg = <9>;
					isp_chn9: endpoint@9 {
					};
				};
				port@a {
					reg = <10>;
					isp_chn10: endpoint@10 {
					};
				};
				port@b {
					reg = <11>;
					isp_chn11: endpoint@11 {
					};
				};
				port@c {
					reg = <12>;
					isp_chn12: endpoint@12 {
					};
				};
				port@d {
					reg = <13>;
					isp_chn13: endpoint@13 {
					};
				};
				port@e {
					reg = <14>;
					isp_chn14: endpoint@14 {
					};
				};
				port@f {
					reg = <15>;
					isp_chn15: endpoint@15 {
					};
				};
			};
		};
	};
};

&spi0 {
	status = "disable";
	slave@0 {
		compatible = "micron,spi-authenta";
		reg = <0>;
		spi-mode = <0>; /* spi_mode: 0-3 */
		spi-max-frequency = <400000>;
	};
};

&spi1 {
	status = "disable";
	slave@0 {
		compatible = "micron,spi-authenta";
		spi-mode = <0>; /* spi_mode: 0-3 */
		spi-max-frequency = <400000>;
	};
};

&spi2 {
	status = "disable";
	slave@0 {
		compatible = "micron,spi-authenta";
		reg = <0>;
		spi-mode = <0>; /* spi_mode: 0-3 */
		spi-max-frequency = <400000>;
	};
};

&spi3 {
	status = "disable";
	slave@0 {
		compatible = "micron,spi-authenta";
		spi-mode = <0>; /* spi_mode: 0-3 */
		spi-max-frequency = <400000>;
	};
};

