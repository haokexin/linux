/dts-v1/;
#include "bstc1200.dtsi"

/ {
	compatible = "bst,c1200";
	model = "BST C1200";

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0x20007000 console=ttyS0,115200n8 rdinit=/sbin/init root=/dev/ram rw init=/linuxrc rodata=n";
		stdout-path = "uart0";
	};

	/* This is used to push the total usable DDR to Normal Zone
	 * DON NOT USE IT !!!
	 */
	memory@1000000 {
	device_type = "memory";
	reg = <0x0 0x1000000 0x0 0x1000>;
	};

	memory@c00000000 {
	device_type = "memory";
	reg = <0xc 0x40000000 0x1 0x80000000>;
	};

	memory@800000000 {
	device_type = "memory";
	reg = <0x8 0x00000000 0x0 0x20000>;
	};

	memory@800000000 {
        device_type = "memory";
        reg = <0x8 0x6400000 0x0 0x100000>;
    };

	memory@837000000 {
        device_type = "memory";
        reg = <0x8 0x37000000 0x0 0x09000000
			   0x8 0x50000000 0x0 0x03000000
			   0xc 0x50000000 0x0 0x03000000
		>;
    };

	memory@806a10000 {
		device_type = "memory";
		reg = <0x8 0x06a10000 0x0 0x100000>;
	};
	memory@80e800000 {
		device_type = "memory";
		reg = <0x8 0x0e800000 0x0 0x800000>;
	};
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		its_table_reserved: its_table@806a10000 {
			reg = <0x8 0x06a10000 0x0 0x100000>;
			no-map;
		};

		bst_ufs_reserved: bst_ufs@800000000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x000000 0x0 0x20000>;
			no-map;
		};

		scmi_buf_reserved: scmi_buf@800152000 {
            compatible = "shared-dma-pool";
            reg = <0x8 0x152000 0x0 0x1000>;
            no-map;
        };


		reserved_for_normal_zone: reserved@1000000 {
			reg = <0x0 0x1000000 0x0 0x1000>;
			no-map;
		};

		bst_nor_flash_code_reserved: bst_nor_flash@800140000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x140000 0x0 0x10000>;
			no-map;
		};

		/* bst vpu private memory pool */
		bst_vpu_reserved: bst_vpu_reserved {
			compatible = "secure-dma-pool";
			align-shift = <8>;
			reg = <0xc 0x60000000 0x0 0x20000000>;
			reusable;
		};

		bst_dpu_reserved: bst_dpu_cma@c80000000 {
			compatible = "shared-dma-pool";
			reg = <0xc 0x80000000 0x0 0x10000000>;
			reusable;
		};


		bst_ipc_reserved: bst_ipc@800400000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x00400000 0x0 0x100000>;
			no-map;
		};



		bst_sramxrp_reserved: bst_sramxrp0@806400000{
            compatible = "shared-dma-pool";
            reg = <0x8 0x6400000 0x0 0x100000>;
            no-map;
		};

		bst_touchscreen_reserved: bst_touchscreen@806690000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x06690000 0x0 0x40000>; //256k
			no-map;
		};

		bst_minidump_reserved: bst_minidump@d00000000 {
			compatible = "bst,minidump";
			reg = <0xd 0x00000000 0x0 0xA00000>;
			no-map;
		};

		bst_mrdump_cb_reserved: bst_mrdump@d00a00000 {
			compatible = "bst,mrdump_cb";
			reg = <0xd 0xa00000 0x0 0x200000>;
			no-map;
		};

		bst_hif_reserved: bst_hif_des@d00c00000 {
			compatible = "shared-dma-pool";
			reg = <0xd 0xc00000 0x0 0x40000>;
			no-map;
		};

		/*reserved for global secure dmabuf */
		global_dmabuf_secure_reserved: global_secure_dmabuf@850000000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x50000000 0x0 0x03000000
                   0xc 0x50000000 0x0 0x03000000
			>;
			no-map;
		};
		/*reserved for global normal dmabuf */
		global_dmabuf_normal_reserved: global_normal_dmabuf@837000000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x37000000 0x0 0x09000000>;
			no-map;
		};
		bst_usb_virt_reserved: usb_virt@80e800000 {
			reg = <0x8 0x0e800000 0x0 0x800000>;
			no-map;
		};
	};

/****************************************************************************************/
/*	c0_lockstep/c1_split	1 + 5: c0 0x0 + c0 0x100 \ c1 0x0 ~ 0x300
 *	c0_lockstep/c1_lockstep	1 + 3: c0 0x0 + c0 0x100 \ c1 0x0 ~ 0x100
 *	split			2 + 6: c0 0x0 ~ 0x100 + c0 0x200 ~ 0x300 \ c1 0x0 ~ 0x300
 *	split			4 + 4: c0 0x0 ~ 0x300 + c1 0x0 ~ 0x300
 */
/****************************************************************************************/
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		/* cluster 0 */
		cpu_l0: cpu@0 {
			compatible = "arm,cortex-a78", "arm,armv8";
			device_type = "cpu";
			enable-method = "psci";
			next-level-cache = <&l2_0>;
			reg = <0x0>;
			freq-domain = <&cpufreq 0>;
		};
		cpu_l1: cpu@1 {
			compatible = "arm,cortex-a78", "arm,armv8";
			device_type = "cpu";
			enable-method = "psci";
			next-level-cache = <&l2_0>;
			reg = <0x100>;
			freq-domain = <&cpufreq 0>;
		};
		cpu_l2: cpu@2 {
			compatible = "arm,cortex-a78", "arm,armv8";
			device_type = "cpu";
			enable-method = "psci";
			next-level-cache = <&l2_0>;
			reg = <0x200>;
			freq-domain = <&cpufreq 0>;
		};
		cpu_l3: cpu@3 {
			compatible = "arm,cortex-a78", "arm,armv8";
			device_type = "cpu";
			enable-method = "psci";
			next-level-cache = <&l2_0>;
			reg = <0x300>;
			freq-domain = <&cpufreq 0>;
		};

		l2_0: l2-cache-0 {
			compatible = "cache";
		};
		

		/* cluster 1 */
		/*
		cpu_b0: cpu@100 {
			compatible = "arm,cortex-a78", "arm,armv8";
			device_type = "cpu";
			enable-method = "psci";
			next-level-cache = <&l2_1>;
			reg = <0x10000>;
			freq-domain = <&cpufreq 1>;
		};
		cpu_b1: cpu@101 {
			compatible = "arm,cortex-a78", "arm,armv8";
			device_type = "cpu";
			enable-method = "psci";
			next-level-cache = <&l2_1>;
			reg = <0x10100>;
			freq-domain = <&cpufreq 1>;
		};
		cpu_b2: cpu@102 {
			compatible = "arm,cortex-a78", "arm,armv8";
			device_type = "cpu";
			enable-method = "psci";
			next-level-cache = <&l2_1>;
			reg = <0x10200>;
			freq-domain = <&cpufreq 1>;
		};
		cpu_b3: cpu@103 {
			compatible = "arm,cortex-a78", "arm,armv8";
			device_type = "cpu";
			enable-method = "psci";
			next-level-cache = <&l2_1>;
			reg = <0x10300>;
			freq-domain = <&cpufreq 1>;
		};

		l2_1: l2-cache-1 {
			compatible = "cache";
		};*/
	};

	psci {
		compatible	= "arm,psci-1.0";
		method		= "smc";
		cpu_on		= <0xC4000003>;
		cpu_off		= <0x84000002>;
		cpu_suspend	= <0xC4000001>;
	};


    es8316-sound {
        status = "okay";
        compatible = "simple-audio-card";
        simple-audio-card,format = "i2s";
        simple-audio-card,name = "everest,es8316-codec";
        simple-audio-card,mclk-fs = <256>;
        //simple-audio-card,bitclock-master = <&sndcodec>;
        //simple-audio-card,frame-master = <&sndcodec>;

        simple-audio-card,cpu {
            sound-dai = <&i2s0>;
        };

        sndcodec: simple-audio-card,codec {
            sound-dai = <&es8316>;
        };
    };


    pcm3168a-sound {
        status = "okay";
        compatible = "simple-audio-card";
        simple-audio-card,format = "i2s";
        simple-audio-card,name = "everest,pcm3168a-codec";
        simple-audio-card,mclk-fs = <256>;

        simple-audio-card,cpu {
            sound-dai = <&tdm2>;
        };

        simple-audio-card,codec {
            sound-dai = <&pcm3168a>;
        };
    };

    bst_adsp_i2s_codec0:adsp_i2s_codec0 {
         compatible = "linux,i2s-adsp-codec0";
         #sound-dai-cells = <0>;
         status = "disable";
    };
    bst_adsp_i2s_codec1:adsp_i2s_codec1 {
         compatible = "linux,i2s-adsp-codec1";
         #sound-dai-cells = <0>;
         status = "disable";
    };
    bst_adsp_tdm_codec0:adsp_tdm_codec0 {
         compatible = "linux,tdm-adsp-codec0";
         #sound-dai-cells = <0>;
         status = "disable";
    };
    bst_adsp_tdm_codec1:adsp_tdm_codec1 {
         compatible = "linux,tdm-adsp-codec1";
         #sound-dai-cells = <0>;
         status = "disable";
    };

    bst_rfkill_bt: rfkill_bt {
        status = "disable"; 
        compatible = "bst,rfkill_bt";
        type = "bluetooth";
        reset-gpios = <&porte 24 GPIO_ACTIVE_HIGH>;
    };

    adsp21569_sound0 {
        status = "okay";
        compatible = "simple-audio-card";
        simple-audio-card,format = "i2s";
        simple-audio-card,name = "everest,adsp21569-codec-tdm0";
        simple-audio-card,mclk-fs = <256>;

        simple-audio-card,cpu {
            sound-dai = <&tdm0>;
        };

        simple-audio-card,codec {
            sound-dai = <&bst_adsp_tdm_codec0>;
        };
    };

    adsp21569_sound1 {
        status = "okay";
        compatible = "simple-audio-card";
        simple-audio-card,format = "i2s";
        simple-audio-card,name = "everest,adsp21569-codec-i2s1";
        simple-audio-card,mclk-fs = <256>;

        simple-audio-card,cpu {
            sound-dai = <&i2s1>;
        };

        simple-audio-card,codec {
            sound-dai = <&bst_adsp_i2s_codec0>;
        };
    };

    adsp21569_sound2 {
        status = "okay";
        compatible = "simple-audio-card";
        simple-audio-card,format = "i2s";
        simple-audio-card,name = "everest,adsp21569-codec-i2s2";
        simple-audio-card,mclk-fs = <256>;

        simple-audio-card,cpu {
            sound-dai = <&i2s2>;
        };

        simple-audio-card,codec {
            sound-dai = <&bst_adsp_i2s_codec1>;
        };
    };

};

&firmware_scmi {

	shmem = <&scmi_buf_reserved>;
	reg = <0x0 0x20011000 0 0x14>;


	status = "okay";
};



&i2c0 {
	status = "disable";
};

&i2c1 {
	status = "disable";
};

&i2c2 {
	status = "okay";
	es8316: es8316@11 {
		compatible = "everest,es8316";
		reg = <0x11>;
		#sound-dai-cells = <0>;
		es8316,analog-input-mux = <1>;
	};

	pcm3168a: pcm3168a-codec@44 {
		compatible = "ti,pcm3168a";
		reg = <0x44>;
		#sound-dai-cells = <0>;
	};
};

&i2c3 {
	status = "disable";
};

&i2c4 {
	status = "okay";

	ccg7d@8 {
		compatible = "bst,ccgx";
		reg = <0x08>;
		status = "okay";
		int-gpio = <&porte 25 GPIO_ACTIVE_LOW>;
		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "source";
			//try-power-role = "sink";
			//source-pdos = <PDO_FIXED(5000, 2000, PDO_FIXED_USB_COMM)>;
			//sink-pdos = <PDO_FIXED(5000, 2000, PDO_FIXED_USB_COMM)
			//             PDO_VAR(5000, 12000, 2000)>;
			//op-sink-microwatt = <10000000>;
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
						reg = <0>;
						typec_usb_port: endpoint@0 {
								remote-endpoint = <&usb3_role_switch>;
						};
						typec_switch_port: endpoint@1 {
								remote-endpoint = <&usb3_orientation_switch>;
						};
						typec_mode_switch_port: endpoint@2 {
								remote-endpoint = <&usb3_mode_switch>;
						};
				};
			};
		};
	};
};

