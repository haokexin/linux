&bst_disp_fw_msgbx {
	status = "disable";
	msgbx-pid = "CPU_0"; /* "CPU_0" - "CPU_3" */
};

&bst_disp_fw_ipc {
	status = "okay";
	memory-region = <&bst_dpu_buf_reserved>;
	ipc-pid = "ARM0";
};

&bst_virt_dpu0 {
	status = "okay";
	os-type = "IVI";
	pipeline@0 {
		status = "okay";
		layer-num = <1>;
		port@0 {
			virt_pipe0_out: endpoint@0 {
				remote-endpoint = <&virt_dptx_in>;
			};
		};
	};
	pipeline@1 {
		status = "okay";
		layer-num = <1>;
		port@0 {
			virt_pipe1_out: endpoint@0 {
				remote-endpoint = <&virt_dsi1_in>;
			};
		};
	};
	pipeline@2 {
		status = "okay";
		layer-num = <1>;
		port@0 {
			reg = <0>;
			virt_pipe2_out: endpoint@0 {
				remote-endpoint = <&virt_dsi0_in>;
			};
		};
	};
	pipeline@3 {
		status = "okay";
		layer-num = <1>;
		port@0 {
			reg = <0>;
			virt_shared_pipe0_out: endpoint@0 {
				remote-endpoint = <&virt_lvds1_in>;
			};
		};
	};
};

&bst_virt_dptx {
	status = "okay";
	backlight = <&backlight_edp>;
	ports {
		port@0 {
			virt_dptx_in: endpoint@0 {
				remote-endpoint = <&virt_pipe0_out>;
			};
		};
	};
};

&bst_virt_dsi0 {
	status = "okay";
	backlight = <&backlight_dsi0>;
	ports {
		port@0 {
			virt_dsi0_in: endpoint@0 {
				remote-endpoint = <&virt_pipe2_out>;
			};
		};
	};
};

&bst_virt_dsi1 {
	status = "okay";
	backlight = <&backlight_dsi1>;
	ports {
		port@0 {
			virt_dsi1_in: endpoint@0 {
				remote-endpoint = <&virt_pipe1_out>;
			};
		};
	};
};

&bst_virt_lvds1 {
	status = "okay";
	backlight = <&backlight_lvds1>;
	ports {
		port@0 {
			virt_lvds1_in: endpoint@0 {
				remote-endpoint = <&virt_shared_pipe0_out>;
			};
		};
	};
};

&gpu_ivi {
	status = "okay";
};

&gpu_adas {
	status = "disable";
};

&gpu_db {
	status = "disable";
};

&pinctrl {
	status = "disable";
};

&clkc {
	status = "disable";
};

&gtc {
	status = "okay";
};

&xgmac0 {
	status = "disable";
};

&gic600 {
	status = "okay";
	};

&its0_x4 {
	status = "okay";
	memory-region = <&its_table_reserved>;
};

&vmac {
	status = "okay";
	interrupt-parent = <&gic600>;
	interrupts = <GIC_SPI 480 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 481 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 482 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 483 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 484 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 485 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 486 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 487 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "vmac_irq0", "vmac_irq1", "vmac_irq2", "vmac_irq3",
		"vmac_irq4", "vmac_irq5", "vmac_irq6", "vmac_irq7";
	//mac-address = [52AECD28264B];
	channel-bit = <0x00000000 0x00010000>;
	max-frame-size = <3800>;
	tx-queues-to-use = <1>;
	rx-queues-to-use = <1>;
	memory-region = <&bst_vmac_reserved>;
};


&ipc {
	status = "okay";
	memory-region = <&bst_ipc_reserved>;
};

&mbox {
	status = "okay";
	ipc-cpus = <0>;
	memory-region = <&bst_ipc_reserved>;
};



&msgbox {
	status = "okay";
	spi-irq-num = <4>;
	filter-num = <8>;
	// id = <0x0>;
	// end0 and end1 spi irq
	interrupts =    <
			GIC_PPI 2 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
			GIC_PPI 3 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
			GIC_PPI 4 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
			GIC_PPI 15 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
			GIC_SPI 544 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 545 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 546 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 547 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 548 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 549 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 550 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 551 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 552 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 553 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 554 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 555 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 556 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 557 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 558 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 559 (IRQ_TYPE_LEVEL_HIGH)
			>;
	#mbox-cells = <0x1>;
};

&arm_pmu {
	status = "disable";
};

&gmac0 {
	status = "disable";
	phy-handle = <&eth_phy1>;
	extend-op = <20>;
	phy-mode = "sgmii";
	mac-mode = "gmii";
	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";		
		eth_phy1: eth_phy1@1 {
			compatible = "marvell,88E1510", "ethernet-phy-id0141.0DD1", "ethernet-phy-ieee802.3-c22";
			device_type = "ethernet-phy";
			max-speed = <1000>;
			reg = <0x1>;
			reset-active-low;
			reset-gpios = <&porte 16 1>; //gpio 144
			reset-assert-us = <20000>;
			reset-deassert-us = <20000>;
		};
		
	};
};

&virtouch {
	status = "disable";
	memory-region = <&bst_touchscreen_reserved>;
	/*
	 * client-id:
	 * 0x41444153: "ADAS"
	 * 0x49564920: "IVI "
	 * 0x44422020: "DB  "
	 */
	client-id = <0x49564920>; //as same as display client id
	/*
	 * screens-id:
	 * 0x9: screen_lvds0  adas
	 * 0xa: screen_lvds1  adas/ivi/db
	 * 0x7: screen_dsi0  ivi
	 * 0x8: screen_dsi1  ivi
	 * 0x6: screen_edp   adas/ivi
	 */
	screens-id = <0xa>, <0x7>,  <0x8>, <0x6>;
};

&backlight_lvds1 {
	client-id = <0x49564920>;
	status = "okay";
};
&backlight_dsi0 {
	client-id = <0x49564920>;
	status = "okay";
};
&backlight_dsi1 {
	client-id = <0x49564920>;
	status = "okay";
};
&backlight_edp {
	client-id = <0x49564920>;
	status = "okay";
};

&mmu600_coreip {
	status = "okay";
};

&bstn_bus {
       /*           cpu va          net va         size          */
       dma-ranges = <0x0 0x80000000 0x0 0x80000000 0x0 0x40000000>; /* ivi msg */
};

&bstn {
       status = "okay";
       iommus = <&mmu600_coreip 1>,<&mmu600_coreip 4>;
       msgbox-endid = <0x11>;
       //dma-coherent;
};

&cv_bus {
	dma-ranges = <0x0 0x80000000 0xc 0x90000000 0x0 0x40000000>;
};

&bst_cvsmm {
	status = "okay";
	iommus = <&mmu600_coreip 2>;
};

&hwcv {
	status = "okay";
	use-cvsmm;
	ipc-sem = <3 0 8>; //<master_id bank_id msg_id>
};
