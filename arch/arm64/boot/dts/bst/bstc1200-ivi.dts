/dts-v1/;
#include <generated/autoconf.h>
#include <dt-bindings/mailbox/bst_msgbox.h>
#include <dt-bindings/media/bst-isp.h>

#include "bstc1200.dtsi"

/ {
	compatible = "bst,c1200";
	model = "BST C1200";

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0x20007000 console=ttyS0,115200n8 rdinit=/sbin/init root=/dev/ram rw init=/linuxrc rodata=n";
		stdout-path = "uart0";
	};

	/* This is used to push the total usable DDR to Normal Zone
	 * DON NOT USE IT !!!
	 */

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		its_table_reserved: its_table@806a10000 {
			reg = <0x8 0x06a10000 0x0 0x100000>;
		};

		bst_ufs_reserved: bst_ufs@800000000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x000000 0x0 0x20000>;
			no-map;
		};

		scmi_buf_reserved: scmi_buf@800152000 {
            compatible = "shared-dma-pool";
            reg = <0x8 0x152000 0x0 0x1000>;
            no-map;
        };


		reserved_for_normal_zone: reserved@1000000 {
			reg = <0x0 0x1000000 0x0 0x1000>;
			no-map;
		};

		bst_nor_flash_code_reserved: bst_nor_flash@800140000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x140000 0x0 0x10000>;
			no-map;
		};

		/* bst vpu private memory pool */
		bst_vpu_reserved: bst_vpu_reserved {
			compatible = "secure-dma-pool";
			align-shift = <8>;
			reg = <0xc 0x60000000 0x0 0x20000000>;
			reusable;
		};

		/* Reserved for exchange message between driver and firmware */
		isp_fw_msg_rsv: bst_isp_msg@821000000 {
			reg = <0x8 0x21000000 0x0 0x1000000>;
			/* Reserved IOVA for fixed map */
			iommu-addresses = <&isp 0x0 0x3E000000 0x0 0x42000000>;
			no-map;
		};

		/* Reserved exclusively for firmware */
		isp_fw_buf_rsv: bst_isp_buf@822000000 {
			reg = <0x8 0x22000000 0x0 0x15000000>;
			no-map;
		};

		bst_ipc_reserved: bst_ipc@800300000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x300000 0x0 0x400000>;
			no-map;
		};

		bst_sramxrp_reserved: bst_sramxrp0@806400000{
            compatible = "shared-dma-pool";
            reg = <0x8 0x6400000 0x0 0x80000>;
            no-map;
		};

		bst_touchscreen_reserved: bst_touchscreen@806690000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x06690000 0x0 0x40000>; //256k
			no-map;
		};	

		bst_vmac_reserved: bst_vmac_des@806c10000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x0cc00000 0x0 0x900000>; //9M
			no-map;
		};

		/*reserved for global secure dmabuf */
		global_dmabuf_secure_reserved: global_secure_dmabuf@850000000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x50000000 0x0 0x03000000
                   0xc 0x50000000 0x0 0x03000000
			>;
			no-map;
		};
		/*reserved for global normal dmabuf */
		global_dmabuf_normal_reserved: global_normal_dmabuf@837000000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x53000000 0x0 0x2d000000
				   0x8 0x37000000 0x0 0x19000000
				  >;
		};
		/*reserved for global hifi dmabuf */
		global_dmabuf_hifi_reserved: global_hifi_dmabuf@806480000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x06480000 0x0 0x00080000>;
			no-map;
		};
		bst_usb_virt_reserved: usb_virt@80e000000 {
			reg = <0x8 0x0e000000 0x0 0x1000000>;
			no-map;
		};
		bst_dpu_buf_reserved: bst_dpu_buf@806922000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x06922000 0x0 0x1000>;
			no-map;
		};
	
		bst_hwrng_buf_reserved: bst_hwrng_buf@806d40000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x06d31000 0x0 0x1000>;
		};

		bst_minidump_reserved: bst_minidump@db0000000 {
			compatible = "bst,minidump";
			reg = <0xd 0xb0000000 0x0 0xA00000>;
			no-map;
		};

		bst_mrdump_cb_reserved: bst_mrdump@db0a00000 {
			compatible = "bst,mrdump_cb";
			reg = <0xd 0xb0a00000 0x0 0x200000>;
			no-map;
		};
	};

/****************************************************************************************/
/*	c0_lockstep/c1_split	1 + 5: c0 0x0 + c0 0x100 \ c1 0x0 ~ 0x300
 *	c0_lockstep/c1_lockstep	1 + 3: c0 0x0 + c0 0x100 \ c1 0x0 ~ 0x100
 *	split			2 + 6: c0 0x0 ~ 0x100 + c0 0x200 ~ 0x300 \ c1 0x0 ~ 0x300
 *	split			4 + 4: c0 0x0 ~ 0x300 + c1 0x0 ~ 0x300
 */
/****************************************************************************************/
	psci {
		compatible	= "arm,psci-1.0";
		method		= "smc";
		cpu_on		= <0xC4000003>;
		cpu_off		= <0x84000002>;
		cpu_suspend	= <0xC4000001>;
	};

    es8316-sound {
        status = "okay";
        compatible = "simple-audio-card";
        simple-audio-card,format = "i2s";
        simple-audio-card,name = "everest,es8316-codec";
        simple-audio-card,mclk-fs = <256>;
        //simple-audio-card,bitclock-master = <&sndcodec>;
        //simple-audio-card,frame-master = <&sndcodec>;

        simple-audio-card,cpu {
            sound-dai = <&i2s0>;
        };

        sndcodec: simple-audio-card,codec {
            sound-dai = <&es8316>;
        };
    };


    pcm3168a-sound {
        status = "okay";
        compatible = "simple-audio-card";
        simple-audio-card,format = "i2s";
        simple-audio-card,name = "everest,pcm3168a-codec";
        simple-audio-card,mclk-fs = <256>;

        simple-audio-card,cpu {
            sound-dai = <&tdm2>;
        };

        simple-audio-card,codec {
            sound-dai = <&pcm3168a>;
        };
    };

    bst_adsp_i2s_codec0:adsp_i2s_codec0 {
        compatible = "linux,i2s-adsp-codec0";
        #sound-dai-cells = <0>;
        status = "disable";
    };

    bst_adsp_i2s_codec1:adsp_i2s_codec1 {
        compatible = "linux,i2s-adsp-codec1";
        #sound-dai-cells = <0>;
        status = "disable";
    };

    bst_adsp_tdm_codec0:adsp_tdm_codec0 {
        compatible = "linux,tdm-adsp-codec0";
        #sound-dai-cells = <0>;
        status = "disable";
        tx_slot_cnt = <8>;
        rx_slot_cnt = <6>;
    };

    bst_adsp_tdm_codec1:adsp_tdm_codec1 {
        compatible = "linux,tdm-adsp-codec1";
        #sound-dai-cells = <0>;
        status = "disable";
        tx_slot_cnt = <8>;
        rx_slot_cnt = <6>;
    };

    bst_rfkill_bt: rfkill_bt {
        status = "disable"; 
        compatible = "bst,rfkill_bt";
        type = "bluetooth";
        reset-gpios = <&porte 24 GPIO_ACTIVE_HIGH>;
    };

    adsp21569_sound0 {
        status = "okay";
        compatible = "simple-audio-card";
        simple-audio-card,format = "i2s";
        simple-audio-card,name = "everest,adsp21569-codec-tdm1";
        simple-audio-card,mclk-fs = <256>;

        simple-audio-card,cpu {
            sound-dai = <&tdm1>;
        };

        simple-audio-card,codec {
            sound-dai = <&bst_adsp_tdm_codec1>;
        };
    };

    adsp21569_sound1 {
        status = "okay";
        compatible = "simple-audio-card";
        simple-audio-card,format = "i2s";
        simple-audio-card,name = "everest,adsp21569-codec-i2s0";
        simple-audio-card,mclk-fs = <256>;

        simple-audio-card,cpu {
            sound-dai = <&i2s0>;
        };

        simple-audio-card,codec {
            sound-dai = <&bst_adsp_i2s_codec0>;
        };
    };

    adsp21569_sound2 {
        status = "okay";
        compatible = "simple-audio-card";
        simple-audio-card,format = "i2s";
        simple-audio-card,name = "everest,adsp21569-codec-i2s2";
        simple-audio-card,mclk-fs = <256>;

        simple-audio-card,cpu {
            sound-dai = <&i2s2>;
        };

        simple-audio-card,codec {
            sound-dai = <&bst_adsp_i2s_codec1>;
        };
    };

};

&firmware_scmi {

	shmem = <&scmi_buf_reserved>;
	reg = <0x0 0x20011000 0 0x14>;


	status = "okay";

	 scmi_pinctrl: protocol@19 {
		reg = <0x19>;
		#pinctrl-cells = <0>;

		isp_pinctrl:isp_pinctrl {
			mux {
				pins = "WK_GPIO33", "WK_GPIO34","WK_GPIO35","ISP_FSYNC0","ISP_FSYNC1","ISP_FSYNC2";
				function = "isp";
			};
		};
		deser_pinctrl: deser_pinctrl {
				deser_pdb_pins {
					/* Deser 0 PDB, Deser 1 PDB, Deser 2 PDB */
					pins = "WK_GPIO15", "WK_GPIO20", "WK_GPIO21";
					function = "gpio";
				};
				deser_status_pins {
					/* Deser 0 LOCK, ERR, Deser 1 LOCK, ERR, Deser 2 LOCK, ERR */
					pins = "SC_SDMMC0_WP", "SC_SDMMC1_STROBE", "SC_SDMMC1_CLK", "SC_SDMMC1_CMD", "SC_SDMMC1_DAT0", "SC_SDMMC1_DAT1";
					function = "gpio";
					bias-pull-up;
					input-enable;
				};
			};
        };
};

&hwrng {
	status = "okay";
	memory-region = <&bst_hwrng_buf_reserved>;
	msgbx-pid = <0x10>;
};

&i2c0 {
	status = "disable";
};

&i2c1 {
	status = "disable";
};

&i2c2 {
	status = "okay";
	es8316: es8316@11 {
		compatible = "everest,es8316";
		reg = <0x11>;
		#sound-dai-cells = <0>;
		es8316,analog-input-mux = <1>;
	};

	pcm3168a: pcm3168a-codec@44 {
		compatible = "ti,pcm3168a";
		reg = <0x44>;
		#sound-dai-cells = <0>;
	};
};

&i2c3 {
	status = "disable";
};

&i2c4 {
	status = "okay";

	ccg7d@8 {
		compatible = "bst,ccgx";
		reg = <0x08>;
		status = "okay";
		int-gpio = <&porte 25 GPIO_ACTIVE_LOW>;
		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "source";
			//try-power-role = "sink";
			//source-pdos = <PDO_FIXED(5000, 2000, PDO_FIXED_USB_COMM)>;
			//sink-pdos = <PDO_FIXED(5000, 2000, PDO_FIXED_USB_COMM)
			//             PDO_VAR(5000, 12000, 2000)>;
			//op-sink-microwatt = <10000000>;
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 {
						reg = <0>;
						typec_usb_port: endpoint@0 {
								remote-endpoint = <&usb3_role_switch>;
						};
						typec_switch_port: endpoint@1 {
								remote-endpoint = <&usb3_orientation_switch>;
						};
						typec_mode_switch_port: endpoint@2 {
								remote-endpoint = <&usb3_mode_switch>;
						};
				};
			};
		};
	};
};

&i2c5 {
	status = "disable";
};

&i2c6 {
	status = "disable";
};

&i2c7 {
	status = "disable";
};

&i2cq0 {
	uid = <3>;
	ipc-sem = <3 0 12>;	// Master 3, bank 0, sem 12
	role = <ROLE_SLAVE>;
};
&i2cq1 {
	uid = <3>;
	ipc-sem = <3 0 12>;	// Master 3, bank 0, sem 12
	role = <ROLE_SLAVE>;
};
&i2cq2 {
	uid = <3>;
	ipc-sem = <3 0 12>;	// Master 3, bank 0, sem 12
	role = <ROLE_SLAVE>;
};
&csi0 {
	uid = <3>;
	ipc-sem = <3 0 13>;	// Master 3, bank 0, sem 13
};
&csi1 {
	uid = <3>;
	ipc-sem = <3 0 13>;	// Master 3, bank 0, sem 13
};
&csi2 {
	uid = <3>;
	ipc-sem = <3 0 13>;	// Master 3, bank 0, sem 13
};
&isp_bus {
	dma-ranges = <0x0 0x80000000 0xC 0x90000000 0x0 0x3E000000>,
		     <0x0 0x3E000000 0x0 0x3E000000 0x0 0x02000000>,	// Reserved to restrict IOVA area
		     <0x0 0x40000000 0x0 0x20000000 0x0 0x07000000>,	// Outer registers area
		     <0x0 0x47000000 0x0 0x30000000 0x0 0x01000000>,	// Outer registers area
		     <0x0 0x50000000 0x0 0x50000000 0x0 0x10000000>,	// ISPCV inner registers
		     <0x0 0x60000000 0x8 0x00200000 0x0 0x00600000>,	// IPC area, see bst_ipc_reserved, 2MB aligned
		     <0x0 0x60600000 0x8 0x21000000 0x0 0x16000000>;	// For isp_fw_msg_rsv, isp_fw_buf_rsv
};
&isp {
	uid = <3>;
	msgbox-cpu = <CPU_1 1 2>;
	ipc-cpu = <0>;		// ARM0
	ipc-sem = <3 0 14>;	// Master 3, bank 0, sem 14
	role = <ROLE_SLAVE>;
};

&uart0 {
	dmas = <&gdma0 55>,
			<&gdma0 54>;
	dma-names = "tx", "rx";
	status = "okay";
};
