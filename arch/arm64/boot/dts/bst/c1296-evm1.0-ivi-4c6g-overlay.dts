/dts-v1/;
/plugin/;

/{
    fragment_root {
        target-path = "/";
        __overlay__ {
            /* This section was used on AOSP v9.0 for defining first-stage fstab records */
            model = "BST C1296 EVM1.0 4C6G";
            firmware {
                android {
                    compatible = "android,firmware";

                    fstab {
                        compatible = "android,fstab";
                    };
                };
            };
        };
    };
};

&scmi_pinctrl {
	i2s0_pinctrl:i2s0_pinctrl  {
        mux {
            pins = "SC_I2S0_SCK", "SC_I2S0_MCK", "SC_I2S0_WS", "SC_I2S0_DIN0", "SC_I2S0_DOUT0";
            function = "i2s0";
        };
    };
    pcm2_pinctrl:pcm2_pinctrl  {
        mux {
            pins = "SC_I2S2_SCK", "SC_I2S2_WS", "SC_I2S2_DIN0", "SC_I2S2_DOUT0";
            function = "pcm2";
        };
    };
	i2s2_pinctrl:i2s2_pinctrl  {
        mux {
            pins = "SC_I2S2_MCK";
            function = "i2s2";
        };
    };
};

&i2c0 {
	status = "disable";
};

&i2c1 {
	status = "disable";
};

&i2c2 {
	status = "okay";
};

&i2c3 {
	status = "disable";
};

&i2c4 {
	status = "okay";
