};

&i2c5 {
	status = "disable";
};

&i2c6 {
	status = "disable";
};

&i2c7 {
	status = "disable";
};

&i2s0 {
    status = "okay";
    use-dma;
    pinctrl-names = "default";
    pinctrl-0 = <&i2s0_pinctrl>;
};

&tdm2 {
    status = "okay";
	pinctrl-names = "default";
    pinctrl-0 = <&pcm2_pinctrl &i2s2_pinctrl>;
};

&es8316 {
    status = "okay";
};

&pcm3168a {
    status = "okay";
};
