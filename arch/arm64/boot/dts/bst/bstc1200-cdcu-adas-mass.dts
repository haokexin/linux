&xgmac0 {
	status = "okay";
	max-speed = <10000>;
	snps,ps-speed = <10000>;
	phy-handle = <&eth_phy0>;
	extend-op = <20>;
	phy-mode = "sgmii";
	mac-mode = "gmii";
	fpe-hs = <0>;
	xpcs-addr = <0>;
	/*bypass;  //bool, set: bypass , non set : non bypass
	pinctrl-names = "default";
        pinctrl-0 = <&soc_xgmac_pinctrl>;*/
	fixed-link {
		speed = <10000>;
		full-duplex;
		pause;
	};
	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";
		eth_phy0: eth_phy0@0 {
			compatible = "marvell,88E1510", "ethernet-phy-id0141.0DD1", "ethernet-phy-ieee802.3-c22";
			device_type = "ethernet-phy";
			max-speed = <1000>;
			reg = <0x1>;
		};

	};
};

