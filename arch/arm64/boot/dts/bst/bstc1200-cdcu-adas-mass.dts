	memory-region = <&bst_sramemmc0_reserved>;
	status = "okay";
};
&mmc1 {
	status = "okay";
	memory-region = <&bst_sramemmc1_reserved>;
	vqmmc-supply=<&v_qmmc>;
	pinctrl-names = "default";
	pinctrl-0 = <&sd_pinctrl>;

};

&mmu600_pcie {
	status = "okay";
};
&mmu600_codec {
	status = "disable";
};
&mmu600_soc {
	status = "okay";
};
&mmu600_coreip {
	status = "okay";
};

&ufs {
	status = "disable";
};

&pcie_phy {
	dmc-lane = <0x1>; /* bit0: 1=2x2ports, 0=1x4ports */
	dmc-mode = <0x3>; /* (bit1 for ctl0)/(bit0 for ctl1):1=RC-mode, 0=EP-mode */
	pcie-ctl0 = <1>;  /* Controller reset */
	pcie-ctl1 = <1>;  /* Controller reset */
	pcie-ref-clk0 = <1>; /* 0=onchip_clk, 1=pad_clk*/
	pcie-ref-clk1 = <1>; /* 0=onchip_clk, 1=pad_clk, 2=repeat_clk */
};

&pcie0 {
	status = "disable";
	reset-gpio = <&portg 24 GPIO_ACTIVE_HIGH>;
	reset-gpio-active-high;
	iommus = <&mmu600_pcie 0x0>;
	iommu-map = <0x0  &mmu600_pcie 0x00 0x1000>;
};

&pcie1 {
	status = "disable";
	reset-gpio = <&portg 25 GPIO_ACTIVE_HIGH>;
	reset-gpio-active-high;
	iommus = <&mmu600_pcie 0x1000>;
	iommu-map = <0x1000  &mmu600_pcie 0x1000 0x1000>;
};

&codec0 {
	compatible = "codec0 arm china,linlon-v5";
	status = "okay";
};
&codec1 {
	compatible = "arm china,linlon-v5";
	status = "okay";
};

