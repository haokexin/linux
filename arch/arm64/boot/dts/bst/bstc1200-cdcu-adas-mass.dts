&bst_disp_fw {
	status = "okay";
	msgbx-pid = "CPU_0"; /* "CPU_0" - "CPU_3" */
};

&bst_virt_dpu0 {
	status = "okay";
	memory-region = <&bst_dpu_reserved>;
	os-type = "ADAS_LINUX";
	pipeline@0 {
		status = "okay";
		dc-type = "DEVICE_TYPE_VIRT_DC_PIPE2";
		layer-num = <4>;
		port@0 {
			virt_pipe0_out: endpoint@0 {
				remote-endpoint = <&virt_dptx_in>;
			};
		};
	};
	pipeline@1 {
		status = "okay";
		dc-type = "DEVICE_TYPE_VIRT_DC_PIPE0";
		layer-num = <4>;
		port@0 {
			virt_pipe1_out: endpoint@0 {
				remote-endpoint = <&virt_dsi1_in>;
			};
		};
	};
	pipeline@2 {
		status = "okay";
		dc-type = "DEVICE_TYPE_VIRT_DC_PIPE4";
		layer-num = <4>;
		port@0 {
			reg = <0>;
			virt_pipe2_out: endpoint@0 {
				remote-endpoint = <&virt_dsi0_in>;
			};
		};
	};
};

&bst_virt_dptx {
	status = "okay";
	ports {
		port@0 {
			virt_dptx_in: endpoint@0 {
				remote-endpoint = <&virt_pipe0_out>;
			};
		};
	};
};

&bst_virt_dsi0 {
	status = "okay";
	ports {
		port@0 {
			virt_dsi0_in: endpoint@0 {
				remote-endpoint = <&virt_pipe2_out>;
			};
		};
	};
};

&bst_virt_dsi1 {
	status = "okay";
	ports {
		port@0 {
			virt_dsi1_in: endpoint@0 {
				remote-endpoint = <&virt_pipe1_out>;
			};
		};
	};
};

