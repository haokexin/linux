/dts-v1/;
/plugin/;

#include "../common/isp-csi-map.dtsi"
#include "base-isp.dtsi"
#include "base-csi-deser-camera.dtsi"
#include "base-desers-3max96724.dtsi"

&isp {
	slab = "isp/common/slab-4x3c-4x3c-4x3c.bin";
};
&csi0 {
	status = "okay";
};
&csi1 {
	status = "okay";
};
&csi2 {
	status = "okay";
};
&deser0 {
	maxim,linkrx-rate = <3 3 3 3>;
	trigger-fps = <30>;
};
&deser1 {
	trigger-fps = <30>;
};
&deser2 {
	trigger-fps = <30>;
};
&isp {
	isp-fsync@0 {
		tx-fps = <30>;
	};
	isp-fsync@1 {
		tx-fps = <30>;
	};
	isp-fsync@2 {
		tx-fps = <30>;
	};
};
&camera0 {
