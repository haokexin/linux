	id-reg = <0x300C>;
	id-val = <0x43>;
	ser-pre-stream-on =
		<0x0330 0x80>,
		<0x0383 0x80>, // Tunnel mode
		<0x0331 0x10>, // 2 data lanes
		<0x0330 0x00>,
		<0x0002 0x43>;
	status = "okay";
};
