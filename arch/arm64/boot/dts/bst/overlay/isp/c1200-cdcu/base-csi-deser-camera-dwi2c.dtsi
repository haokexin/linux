#include <dt-bindings/media/bst-mdev.h>

&i2c5 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	deser0: deser0 {
		deser0_tx1: csi@1 {
			id = <1>;
			phy-if = <IF_DPHY>;
			lane-num = <4>;
			lane-speed = <2500>;
			port {
				deser0_out1: endpoint {
				};
			};
		};

		/* Un-comments these to set CSI2 as CPHY
		deser0_tx2: csi@2 {
			id = <2>;
			phy-if = <IF_CPHY>;
			lane-num = <3>;
			lane-speed = <2000>;
			port {
				deser0_out2: endpoint {
				};
			};
		};
		*/

		deser0_rx_ports: rx-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			deser0_rx0: port@0 {
				reg = <0>;
				gmsl-ver = <GMSL2>;
				rx-rate = <3>;
				endpoint {
					remote-endpoint = <&camera0_out>;
				};
			};
			deser0_rx1: port@1 {
				reg = <1>;
				gmsl-ver = <GMSL2>;
				rx-rate = <3>;
				endpoint {
					remote-endpoint = <&camera1_out>;
				};
			};
			deser0_rx2: port@2 {
				reg = <2>;
				gmsl-ver = <GMSL2>;
				rx-rate = <3>;
				endpoint {
					remote-endpoint = <&camera2_out>;
				};
			};
			deser0_rx3: port@3 {
				reg = <3>;
				gmsl-ver = <GMSL2>;
				rx-rate = <3>;
				endpoint {
					remote-endpoint = <&camera3_out>;
				};
			};
		};
	};

	camera0: camera@71 {
		reg = <0x71>;
		ser-alias = <0x11>;
		sensor-alias = <0x71>;
		status = "disabled";

		port {
			camera0_out: endpoint {
			};
		};
	};

	camera1: camera@72 {
		reg = <0x72>;
		ser-alias = <0x12>;
		sensor-alias = <0x72>;
		status = "disabled";

		port {
			camera1_out: endpoint {
			};
		};
	};

	camera2: camera@73 {
		reg = <0x73>;
		ser-alias = <0x13>;
		sensor-alias = <0x73>;
		status = "disabled";

		port {
			camera2_out: endpoint {
			};
		};
	};

	camera3: camera@74 {
		reg = <0x74>;
		ser-alias = <0x14>;
		sensor-alias = <0x74>;
		status = "disabled";

		port {
			camera3_out: endpoint {
			};
		};
	};
};

