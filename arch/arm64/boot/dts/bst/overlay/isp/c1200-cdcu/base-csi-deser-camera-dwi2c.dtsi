&csi0 {
	func-irq-enable;
	recoverable;
	status = "okay";
};
&csi1 {
	func-irq-enable;
	recoverable;
	status = "okay";
};
&csi2 {
	func-irq-enable;
	recoverable;
	status = "okay";
};
&csi0_in {
	remote-endpoint = <&deser0_out1>;
};
&csi1_in {
	remote-endpoint = <&deser1_out1>;
};
&csi2_in {
	remote-endpoint = <&deser2_out1>;
};
