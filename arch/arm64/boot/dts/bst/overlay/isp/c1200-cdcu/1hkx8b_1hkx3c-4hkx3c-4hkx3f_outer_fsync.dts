/dts-v1/;
/plugin/;
#include "1hkx8b_1hkx3c-4hkx3c-4hkx3f.dts"
&isp {
	isp-fsync@0 {
		source = <FSYNC_OUTER0>;
		rx-fps = <10>;
		rx-pin = <0>;
		pulse-width = <4000>;
	};
	isp-fsync@1 {
		source = <FSYNC_OUTER1>;
		rx-fps = <40>;
		rx-pin = <1>;
		pulse-width = <4000>;

	};
	isp-fsync@2 {
		source = <FSYNC_OUTER2>;
		tx-fps = <25>;
		rx-fps = <25>;
		rx-pin = <2>;
		pulse-width = <4000>;
	};
};
&deser2 {
	trigger-mode = "external";
};
