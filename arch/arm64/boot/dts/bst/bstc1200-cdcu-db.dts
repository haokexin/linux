&gdma0 {
	status = "okay";
	dma-channels = <2>;
	snps,chan-start = <30>;
	snps,block-size = <1048576 1048576>;

	snps,priority = <17 16>;

	interrupts =  < GIC_SPI 99 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
					GIC_SPI 100 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)>;

};

&swdma0 {
	status = "disable";
};

&usbdwc3 {
	interrupts = <0x0 85 0x4>;
};
&usbdwc2 {
