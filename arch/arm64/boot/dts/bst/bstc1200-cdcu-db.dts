&lsp0_pwm0 {
	status = "disable";
};
&lsp1_pwm0 {
	status = "disable";
};

&gpio0 {
	status = "okay";
	pinctrl-names = "default";
    	pinctrl-0 = <&gpio_pinctrl>;

};
&gpio1 {
	status = "okay";
};
&gpio2 {
	status = "okay";
};
&gpio3 {
	status = "okay";
};
&gpio4 {
	status = "okay";
};
&gpio5 {
	status = "okay";
	/*also need to set intterupt table in sbl-dtb
	* and change the gpio5 interrupt from 250 to the number 
	* according to the db interrupts which are routed from soc
	*/
};
&portf {
		interrupts = <GIC_SPI 87 (IRQ_TYPE_LEVEL_HIGH)>;
};
&gpio6 {
	status = "okay";
};
&gpio7 {
	status = "disable";
};
&gpiokeys {
	status = "okay"; //for STR SW3 WAKEUP
};

&gdma0 {
	status = "disable";
};

&swdma0 {
	status = "disable";
};

&usbdwc3 {
	interrupts = <0x0 85 0x4>;
};
&usbdwc2 {
	interrupts = <0x0 86 0x4>;
};
&bst_usb_msg{
	msgbox-pid = "CPUMP2_0";
};
&usbdrd_dwc3 {
	status = "disable";
};
&dwc3 {
	status = "disable";
};



&nor_flash {
	memory-region = <&bst_nor_flash_code_reserved>;
	status = "okay";
};



&mmc0 {
	status = "disable";
};
&mmc1 {
	status = "okay";
};

&mmu600_codec {
	status = "disable";
};
&mmu600_soc {
	status = "disable";
};

&ufs {
	status = "okay";
};

&codec0 {
	status = "disable";
};
&codec1 {
	status = "disable";
};

&mipi_dsi0 {
	status = "disable";
};
&mipi_dsi1 {
	status = "disable";
};
&mipi_csr {
	status = "disable";
};

&bst_dptx {
	status = "disable";
	pinctrl-names = "default";
	pinctrl-0 = <&hpd_pinctrl>;
};

&xrp0 {
	status = "disable";
};

&bst_dpu0 {
	status = "disable";
	memory-region = <&bst_dpu_reserved>;
};
&bst_dpu2 {
	status = "disable";
	memory-region = <&bst_dpu_reserved>;
};
&bst_dpu1 {
	status = "disable";
	memory-region = <&bst_dpu_reserved>;
};

&lvds_conn {
	status = "disable";
	pinctrl-names = "default";
	pinctrl-0 = <&lvds0_pinconfig &lvds1_pinconfig>;
};

&gpu_ivi {
	status = "disable";
};

&gpu_adas {
	status = "disable";
};

&gpu_db {
	status = "okay";
};

&gpu_dma_buf {
	memory-region = <&gpu_dma_buf_reserved>;
};

&pinctrl {
	status = "disable";
};

&clkc {
	status = "okay";
};

&gtc {
	status = "disable";
};

&xgmac0 {
	status = "disable";
};

&hif {
	status = "okay";
	interrupt-parent = <&gic600>;
	interrupts = <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 65 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 66 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 67 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 68 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 69 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 70 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 71 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "hif_irq0", "hif_irq1", "hif_irq2", "hif_irq3",
		"hif_irq4", "hif_irq5", "hif_irq6", "hif_irq7";
	mac-address = [52AECD28C140];
	channel-bit = <0x00000000 0x00000100>;
	max-frame-size = <3800>;
	memory-region = <&bst_hif_reserved>;
};

&gic600 {
	status = "okay";
	reg = <0x0 0x33200000 0 0x10000>,	// GICD
			<0x0 0x33240000 0 0x40000>;	// GICR
};

&ipc {
	status = "okay";
	memory-region = <&bst_ipc_reserved>;
};

&mbox {
	status = "okay";
	memory-region = <&bst_ipc_reserved>;
};



&msgbox {
	status = "okay";
	reg =   <0x0 0x33300000 0 0x100000>; //db
	spi-irq-num = <0>;
	filter-num = <2>;
	interrupts =    <
	GIC_PPI 4 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
	GIC_PPI 15 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
	>;
	#mbox-cells = <0x1>;
};

&arm_pmu {
	status = "disable";
};

&bst_disp_fw {
	status = "okay";
	msgbx-pid = "CPUMP2_0"; /* "CPUMP2_0" "CPUMP2_1" */
};


&bst_virt_dpu0 {
	status = "okay";
	os-type = "DB_LINUX"; /* "ADAS_LINUX", "DB_LINUX" */
	pipeline@0 {
		status = "okay";
		layer-num = <1>;
		dc-type = "DEVICE_TYPE_VIRT_DC_PIPE3";
		port@0 {
			virt_pipe0_out: endpoint@0 {
				remote-endpoint = <&virt_lvds1_in>;
			};
		};
	};
};

&bst_virt_lvds1 {
	status = "okay";
	ports {
		port@0 {
			virt_lvds1_in: endpoint@0 {
				remote-endpoint = <&virt_pipe0_out>;
			};
		};
	};
};

&backlight_lvds1 {
	client-id = <0x1A2B3C4D>;
	status = "okay";
};

&virtouch {
	status = "okay";
	memory-region = <&bst_touchscreen_reserved>;
	client-id = <0x1A2B3C4D>;
	/*
	 * screens-id:
	 * 0x43210000: screen_lvds0  adas
	 * 0x43210001: screen_lvds1  adas/ivi/db
	 * 0x43210002: screen_dsi0  ivi
	 * 0x43210003: screen_dsi1  ivi
	 * 0x43210004: screen_edp   adas/ivi
	 */
	screens-id = <0x43210001>;
};
