&gtc {
	status = "okay";
};

&xgmac0 {
	status = "disable";
};

&vmac {
	status = "okay";
	interrupt-parent = <&gic600>;
	interrupts = <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 65 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 66 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 67 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 68 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 69 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 70 IRQ_TYPE_LEVEL_HIGH>,
			   <GIC_SPI 71 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "vmac_irq0", "vmac_irq1", "vmac_irq2", "vmac_irq3",
		"vmac_irq4", "vmac_irq5", "vmac_irq6", "vmac_irq7";
	//mac-address = [52AECD28C140];
	channel-bit = <0x00000000 0x00000100>;
	max-frame-size = <3800>;
	tx-queues-to-use = <1>;
	rx-queues-to-use = <1>;
	memory-region = <&bst_vmac_reserved>;
};

&gic600 {
	status = "okay";
	reg = <0x0 0x33200000 0 0x10000>,	// GICD
			<0x0 0x33240000 0 0x40000>;	// GICR
};

&ipc {
	status = "okay";
	memory-region = <&bst_ipc_reserved>;
};

&mbox {
	status = "okay";
	ipc-cpus = <4>;
	memory-region = <&bst_ipc_reserved>;
};



&msgbox {
	status = "okay";
	reg =   <0x0 0x33300000 0 0x100000>; //db
	spi-irq-num = <0>;
	filter-num = <2>;
	interrupts =    <
	GIC_PPI 4 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
	GIC_PPI 15 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
	>;
	#mbox-cells = <0x1>;
};

&arm_pmu {
	status = "disable";
};

&bst_disp_fw_msgbx {
	status = "disable";
	msgbx-pid = "CPUMP2_0"; /* "CPUMP2_0" "CPUMP2_1" */
};

&bst_disp_fw_ipc {
	status = "okay";
	memory-region = <&bst_dpu_buf_reserved>;
	ipc-pid = "DB0";
};

&bst_virt_dpu0 {
	status = "okay";
	os-type = "DB"; /* "ADAS", "DB" */
	pipeline@0 {
		status = "okay";
		layer-num = <1>;
		port@0 {
			virt_pipe0_out: endpoint@0 {
				remote-endpoint = <&virt_lvds1_in>;
			};
		};
	};
};

&bst_virt_lvds1 {
	status = "okay";
	backlight = <&backlight_lvds1>;
	ports {
		port@0 {
			virt_lvds1_in: endpoint@0 {
				remote-endpoint = <&virt_pipe0_out>;
			};
		};
	};
};

&backlight_lvds1 {
	client-id = <0x44422020>;
	status = "okay";
};

&virtouch {
	status = "okay";
	memory-region = <&bst_touchscreen_reserved>;
	/*
	 * client-id:
	 * 0x41444153: "ADAS"
	 * 0x49564920: "IVI "
	 * 0x44422020: "DB  "
	 */
	client-id = <0x44422020>;
	/*
	 * screens-id:
	 * 0x9: screen_lvds0  adas
	 * 0xa: screen_lvds1  adas/ivi/db
	 * 0x7: screen_dsi0  ivi
	 * 0x8: screen_dsi1  ivi
	 * 0x6: screen_edp   adas/ivi
	 */
	screens-id = <0xa>;
};

&mmu600_coreip {
	status = "okay";
};

&bstn_bus {
       /*           cpu va          net va         size          */
       dma-ranges = <0x0 0x00100000 0x0 0x00100000 0x0 0x3FF00000>; /* db msg */
};

&bstn {
       status = "okay";
       iommus = <&mmu600_coreip 1>,<&mmu600_coreip 4>;
       msgbox-endid = <0x21>;
       //dma-coherent;
};

&cv_bus {
	dma-ranges = <0x0 0x00100000 0x8 0x8b000000 0x0 0x3ff00000>;
};

&bst_cvsmm {
	status = "okay";
	iommus = <&mmu600_coreip 2>;
};

&hwcv {
	status = "okay";
	use-cvsmm;
	ipc-sem = <2 0 8>; //<master_id bank_id msg_id>
};
