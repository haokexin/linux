/dts-v1/;
#include "bstc1200.dtsi"

/ {
	compatible = "bst,c1200";
	model = "BST C1200 CDCU";

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0x20027000 console=ttyS0,115200n8 rdinit=/sbin/init root=/dev/ram rw init=/linuxrc rodata=n";
		stdout-path = "uart0";
	};

// OS 1GB
	memory@880000000 {
		device_type = "memory";
		reg = <0x00000008 0x80000000 0x00000000 0x40000000
			   0x00000008 0x37000000 0x00000000 0x09000000
			   0x8 0x3400000 0x0 0x1000000
			   0x8 0x50000000 0x0 0x03000000
			   0xc 0x50000000 0x0 0x03000000
		>;
	};

//emmc
	memory@5150000 {
		device_type = "memory";
		reg = <0x0 0x5150000 0x0 0x10000>;
	};

	memory@80e800000 {
		device_type = "memory";
		reg = <0x8 0x0e800000 0x0 0x800000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		bst_ufs_reserved: bst_ufs@800000000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x0 0x0 0x20000>;
			no-map;
		};

			bst_nor_flash_code_reserved: bst_nor_flash@800120000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x120000 0x0 0x10000>;
			no-map;
		};
		
			
		bst_ipc_reserved: bst_ipc@800300000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x00300000 0x0 0x100000>;
			no-map;
		};


			scmi_buf_reserved: scmi_buf@800150000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x150000 0x0 0x1000>;
			no-map;
		};

		bst_sramemmc0_reserved: bst_sramemmc0@5150000{
			compatible = "shared-dma-pool";
			reg = <0x0 0x5150000 0x0 0x10000>;
			no-map;
		};

		bst_datashare_reserved: bst_datashare@804400000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x4400000 0x0 0x500000>;
			no-map;
		};

		bst_touchscreen_reserved: bst_touchscreen@806710000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x06710000 0x0 0x40000>; //256k
			no-map;
		};

		bst_hif_reserved: bst_hif_des@880038000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x80038000 0x0 0x40000>;
			no-map;
		};

		bst_dpu_reserved: bst_dpu_cma@8b0000000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0xb0000000 0x0 0x1000000>;
			reusable;
		};

		/* gpu memory pool */
		gpu_dma_buf_reserved: gpu_cma@8b1000000 {
			compatible = "shared-dma-pool";
			align-shift = <8>;
			reg = <0x8 0xb1000000 0x0 0x4000000>;
			reusable;
		};

		bst_minidump_reserved: bst_minidump@8b5000000 {
			compatible = "bst,minidump";
			reg = <0x8 0xb5000000 0x0 0xA00000>;
			no-map;
		};

		bst_mrdump_cb_reserved: bst_mrdump@8b5a00000 {
			compatible = "bst,mrdump_cb";
			reg = <0x8 0xb5a00000 0x0 0x200000>;
			no-map;
		};

		/*reserved for global secure dmabuf */
		global_dmabuf_secure_reserved: global_secure_dmabuf@850000000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x50000000 0x0 0x03000000
                   0xc 0x50000000 0x0 0x03000000
			>;
			no-map;
		};
		/*reserved for global normal dmabuf */
		global_dmabuf_normal_reserved: global_normal_dmabuf@837000000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x37000000 0x0 0x09000000>;
			no-map;
		};

		bst_optee_reserved: bst_optee@803400000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x3400000 0x0 0x1000000>;
			no-map;
		};
		bst_usb_virt_reserved: usb_virt@80e800000 {
			reg = <0x8 0x0e800000 0x0 0x800000>;
			no-map;
		};
	};
//

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu_l0: cpu@0 {
			compatible = "arm,cortex-a78", "arm,armv8";
			device_type = "cpu";
			enable-method = "psci";
			next-level-cache = <&l2_0>;
			reg = <0x0>;
			freq-domain = <&cpufreq 2>;
		};
		cpu_l1: cpu@1 {
			compatible = "arm,cortex-a78", "arm,armv8";
			device_type = "cpu";
			enable-method = "psci";
			next-level-cache = <&l2_0>;
			reg = <0x100>;
			freq-domain = <&cpufreq 2>;
		};

		l2_0: l2-cache-0 {
			compatible = "cache";
		};
	};


	psci {
		compatible	= "arm,psci-1.0";
		method		= "smc";
		cpu_on		= <0xC4000003>;
		cpu_off		= <0x84000002>;
		cpu_suspend	= <0xC4000001>;
	};

	

	firmware {
		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
			chip-number = <2>;
		};
	};

	tee {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		reg = <0x0 0x18060000 0x0 0x1f000>;
		memory-region = <&bst_optee_reserved>;
		mbox-names = "bst-mbox";
		chip-number = <2>;
	};
};


&firmware_scmi {
	status = "okay";
	shmem = <&scmi_buf_reserved>;
	reg = <0x0 0x20011028 0 0x14>;
	
	
	 scmi_pinctrl: protocol@19 {
                        reg = <0x19>;
                        #pinctrl-cells = <0>;
			
			gpio_pinctrl:gpio_pinctrl {
        			mux {
            				pins = "WK_GPIO13";
            				function = "gpio";
        			};
    			};
			hpd_pinctrl:hpd_pinctrl {
				mux {
					pins = "EDP_HPD";
					function = "edp";
				};
			};
			lvds0_pinconfig:lvds0_pinconfig {
				config {
					pins = "LVDS0_ODD_TX0", "LVDS0_ODD_TX1", "LVDS0_ODD_TX2", "LVDS0_ODD_TX3", "LVDS0_ODD_CLKN";
					input-enable;
				};
			};
			lvds1_pinconfig:lvds1_pinconfig {
				config {
					pins = "LVDS0_EVEN_TX0", "LVDS0_EVEN_TX1", "LVDS0_EVEN_TX2", "LVDS0_EVEN_TX3", "LVDS0_EVEN_CLKN";
					input-enable;
				};
			};
        };
};



&i2c0 {
	status = "disable";
};
&i2c1 {
	status = "disable";
};
&i2c2 {
	status = "disable";
};
&i2c3 {
	status = "disable";
};
&i2c4 {
	status = "disable";
};
&i2c5 {
	status = "disable";
};
&i2c6 {
	status = "disable";
