&lsp0_pwm0 {
	status = "disable";
};
&lsp1_pwm0 {
	status = "disable";
};

&gpio0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&isp_pinctrl &deser_pinctrl>;
};

&porta {
		interrupts = <GIC_SPI 253 (IRQ_TYPE_LEVEL_HIGH)>;
};

&gpio1 {
	status = "okay";
};

&portb {
		interrupts = <GIC_SPI 253 (IRQ_TYPE_LEVEL_HIGH)>;
};

&gpio2 {
	status = "okay";
};

&portc {
		interrupts = <GIC_SPI 253 (IRQ_TYPE_LEVEL_HIGH)>;
};
&gpio3 {
	status = "okay";
};

&portd {
		interrupts = <GIC_SPI 253 (IRQ_TYPE_LEVEL_HIGH)>;
};
&gpio4 {
	status = "okay";
};

&porte {
		interrupts = <GIC_SPI 253 (IRQ_TYPE_LEVEL_HIGH)>;
};
&gpio5 {
	status = "okay";
};

&portf {
		interrupts = <GIC_SPI 253 (IRQ_TYPE_LEVEL_HIGH)>;
};
&gpio6 {
	status = "okay";
