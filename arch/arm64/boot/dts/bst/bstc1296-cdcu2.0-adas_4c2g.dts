&msgbox {
	status = "okay";
	spi-irq-num = <4>;
	filter-num = <8>;
	// id = <0x0>;
	// end0 and end1 spi irq
	interrupts =    <
			GIC_PPI 2 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
			GIC_PPI 3 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
			GIC_PPI 4 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
			GIC_PPI 15 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
            GIC_SPI 560 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 561 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 562 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 563 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 564 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 565 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 566 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 567 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 568 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 569 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 570 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 571 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 572 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 573 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 574 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 575 (IRQ_TYPE_LEVEL_HIGH)
			>;
	#mbox-cells = <0x1>;
};

