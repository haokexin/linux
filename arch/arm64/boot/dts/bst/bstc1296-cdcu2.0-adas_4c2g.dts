/dts-v1/;
#include <generated/autoconf.h>
#include <dt-bindings/mailbox/bst_msgbox.h>
#include <dt-bindings/media/bst-isp.h>

#include "bstc1200.dtsi"
#include "bstc1200-soc-cluster1.dtsi"

/ {
	compatible = "bst,c1200";
	model = "BST C1296 CDCU2.0 4C2G";

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0x20008000 console=ttyS0,115200n8 rdinit=/sbin/init root=/dev/ram rw init=/linuxrc rodata=n";
		stdout-path = "uart0";
	};

	memory@8c0000000 {
		device_type = "memory";
		reg = < 0x8 0x00151000 0x0 0x1000
				0x8 0x00254000 0x0 0x1000
				0x8 0x01400000 0x0 0x1000000
				0x8 0x06a10000 0x0 0x100000
				0x8 0x0e000000 0x0 0x1000000
				0x8 0x10000000 0x0 0x70000000
				0x8 0xc0000000 0x1 0x0
				0xc 0x00000000 0x0 0x800000
				0xc 0x02C00000 0x0 0x3D400000
				0xc 0x50000000 0x0 0x03000000
				0x8 0x06480000 0x0 0x00080000
			>;
	};


	
		// eMMC 48K
	memory@5170000 {
		device_type = "memory";
		reg = <0x0 0x5170000 0x0 0x8000>;
	};


	memory@5178000 {
		device_type = "memory";
		reg = <0x0 0x5178000 0x0 0x8000>;
	};



	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		its_table_reserved: its_table@806a10000 {
			reg = <0x8 0x06a10000 0x0 0x100000>;
		};

        bst_ufs_reserved: bst_ufs@800000000 {
            compatible = "shared-dma-pool";
            reg = <0x8 0x000000 0x0 0x20000>;
            no-map;
        };

		scmi_buf_reserved: scmi_buf@800151000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x151000 0x0 0x1000>;
			no-map;
		};

		bst_nor_flash_code_reserved: bst_nor_flash@800130000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x130000 0x0 0x10000>;
			no-map;
		};

		bst_touchscreen_reserved: bst_touchscreen@806610000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x06610000 0x0 0x40000>; //1M //256k
			no-map;
		};

		bst_sramemmc0_reserved: bst_sramemmc0@5170000{
			compatible = "shared-dma-pool";
			reg = <0x0 0x5170000 0x0 0x8000>;
			no-map;
		};

		bst_sramemmc1_reserved: bst_sramemmc1@5178000{
			compatible = "shared-dma-pool";
			reg = <0x0 0x5178000 0x0 0x8000>;
			no-map;
		};

		bst_minidump_reserved: bst_minidump@94c000000 {
			compatible = "bst,minidump";
			reg = <0x9 0x4c000000 0x0 0xA00000>;
			no-map;
		};

		bst_mrdump_cb_reserved: bst_mrdump@94ca00000 {
			compatible = "bst,mrdump_cb";
			reg = <0x9 0x4ca00000 0x0 0x200000>;
			no-map;
		};

		bst_ipc_reserved: bst_ipc@800300000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x00300000 0x0 0x400000>;
 			no-map;
 		};

		bstn_fw_code_reserved: bstn@810000000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x10000000 0x0 0x2000000>;
			no-map;
		};

		bst_lwnn_fw_code_reserved: bst_lwnn@812000000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x12000000 0x0 0x8000000>;
			no-map;
		};

		/* Reserved for exchange message between driver and firmware */
		isp_fw_msg_rsv: bst_isp_msg@821000000 {
			reg = <0x8 0x21000000 0x0 0x1000000>;
			/* Reserved IOVA for fixed map */
			iommu-addresses = <&isp 0x0 0x3E000000 0x0 0x42000000>;
			no-map;
		};

		/* Reserved exclusively for firmware */
		isp_fw_buf_rsv: bst_isp_buf@822000000 {
			reg = <0x8 0x22000000 0x0 0x15000000>;
			no-map;
		};

		/*reserved for global secure dmabuf */
		global_dmabuf_secure_reserved: global_secure_dmabuf@850000000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x50000000 0x0 0x03000000
                   0xc 0x50000000 0x0 0x03000000
			>;
			no-map;
		};
		/*reserved for global normal dmabuf */
		global_dmabuf_normal_reserved: global_normal_dmabuf@837000000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x53000000 0x0 0x2d000000
				   0x8 0x37000000 0x0 0x19000000
				  >;
		};
		/*reserved for global hifi dmabuf */
		global_dmabuf_hifi_reserved: global_hifi_dmabuf@806480000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x06480000 0x0 0x00080000>;
			no-map;
		};

		bst_optee_reserved: bst_optee@801400000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x1400000 0x0 0x1000000>;
			no-map;
		};

		bst_usb_virt_reserved: usb_virt@80e000000 {
			reg = <0x8 0x0e000000 0x0 0x1000000>;
			no-map;
		};
		/* Reserved exclusively for dpu firmware */
		bst_dpu_buf_reserved: bst_dpu_buf@806920000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x06920000 0x0 0x1000>;
			no-map;
		};

		bst_hwrng_buf_reserved: bst_hwrng_buf@806d30000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x06d30000 0x0 0x1000>;
		};

		/* Reserved for crypto dmabuf */
		bst_crypto_dmabuf_reserved: bst_crypto_dmabuf@806d33000 {
			compatible = "shared-dma-pool";
			reg = <0x8 0x06d33000 0x0 0xA00000>;  //10M
			no-map;
		};
	};

	firmware {
		optee {
                compatible = "linaro,optee-tz";
                method = "smc";
                chip-number = <2>;
        };
	};

	tee {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		reg = <0x0 0x18060000 0x0 0x1f000>;
		memory-region = <&bst_optee_reserved>;
		mbox-names = "bst-mbox";
		chip-number = <2>;
	};
};


	&firmware_scmi {

		shmem = <&scmi_buf_reserved>;
		reg = <0x0 0x20011014 0 0x14>;
		status = "okay";

		scmi_voltage: protocol@17 {

			regulators {
				#address-cells = <1>;
				#size-cells = <0>;
				v_qmmc: regulator {
					reg = <0>;
					regulator-name = "voltage_qmmc";
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <3300000>;
					regulator-always-on;
				};
			};

		};

		scmi_pinctrl: protocol@19 {

				mmc_pinctrl:mmc_pinctrl {
				config {
					pins = "SC_SDMMC0_RSTB","SC_SDMMC0_STROB","SC_SDMMC0_CLK","SC_SDMMC0_CMD"
					,"SC_SDMMC0_DAT0","SC_SDMMC0_DAT1","SC_SDMMC0_DAT2","SC_SDMMC0_DAT3","SC_SDMMC0_DAT4","SC_SDMMC0_DAT5","SC_SDMMC0_DAT6","SC_SDMMC0_DAT7";
					drive-strength = <5>;
					bias-pull-up;
				};
			};

			mmc_pinctrl1:mmc_pinctrl1 {
				config {
					pins = "SC_SDMMC0_CLK";
					drive-strength = <6>;
					bias-pull-up;
				};
			};

			mmc_pinconfig:mmc_pinconfig {
				config {
					pins = "SC_SDMMC0_PVDD0", "SC_SDMMC0_PVDD1", "SC_SDMMC0_PVDD2";
					low-power-disable;
				};
			};


			mmc_pinconfig1:mmc_pinconfig1 {
				config {
					pins = "SC_SDMMC0_PVDD0", "SC_SDMMC0_PVDD1", "SC_SDMMC0_PVDD2";
					low-power-enable;
				};
			};

			isp_pinctrl: isp_pinctrl {
				mux {
					/* ISP FSYNC 0, 1, 2, 5, 6, 7 */
					pins = "ISP_FSYNC0", "ISP_FSYNC1", "ISP_FSYNC2", "WK_GPIO33", "WK_GPIO34","WK_GPIO35";
					function = "isp";
				};
			};
			deser_pinctrl: deser_pinctrl {
				deser_pdb_pins {
					/* Deser 0 PDB, Deser 1 PDB, Deser 2 PDB */
					pins = "WK_GPIO15", "WK_GPIO20", "WK_GPIO21";
					function = "gpio";
				};
				deser_status_pins {
					/* Deser 0 LOCK, ERR, Deser 1 LOCK, ERR, Deser 2 LOCK, ERR */
					pins = "SC_SDMMC0_WP", "SC_SDMMC1_STROBE", "SC_SDMMC1_CLK", "SC_SDMMC1_CMD", "SC_SDMMC1_DAT0", "SC_SDMMC1_DAT1";
					function = "gpio";
					bias-pull-up;
					input-enable;
				};
			};
			hpd_pinctrl:hpd_pinctrl {
				mux {
					pins = "EDP_HPD";
					function = "edp";
				};
			};
			lvds0_pinconfig:lvds0_pinconfig {
				config {
					pins = "LVDS0_ODD_TX0", "LVDS0_ODD_TX1", "LVDS0_ODD_TX2", "LVDS0_ODD_TX3", "LVDS0_ODD_CLKN";
					input-enable;
				};
			};
			lvds1_pinconfig:lvds1_pinconfig {
				config {
					pins = "LVDS0_EVEN_TX0", "LVDS0_EVEN_TX1", "LVDS0_EVEN_TX2", "LVDS0_EVEN_TX3", "LVDS0_EVEN_CLKN";
					input-enable;
				};
			};
			soc_xgmac_pinctrl:soc_xgmac_pinctrl {
				mux {
					pins = "SC_UART2_TXD", "SC_UART2_RXD";    //PAD NAME
					function = "xgmac";
				};
			};

			i2c5_pinctrl:i2c5_pinctrl {
				mux {
					pins = "SC_I2C5_SCL", "SC_I2C5_SDA";
					function = "i2c5";
				};
			};
			i2c6_pinctrl:i2c6_pinctrl {
				mux {
					pins = "SC_I2C6_SCL", "SC_I2C6_SDA";
					function = "i2c6";
				};
			};
			i2c7_pinctrl:i2c7_pinctrl {
				mux {
					pins = "SC_I2C7_SCL", "SC_I2C7_SDA";
					function = "i2c7";
				};
			};
		};
	};

&hwrng {
	status = "okay";
	memory-region = <&bst_hwrng_buf_reserved>;
	msgbx-pid = <0x14>;
};

&i2c0 {
	status = "disable";
};
&i2c1 {
	status = "disable";
};
&i2c2 {
	status = "disable";
};
&i2c3 {
	status = "disable";
};
&i2c4 {
	status = "disable";
};

&i2c5 {
	broken-runtime;
	clock-frequency = <1000000>;
	i2c-sda-falling-time-ns = <10>;
	i2c-scl-falling-time-ns = <10>;
	i2c-sda-hold-time-ns = <10>;

	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pinctrl>;
	status = "disable";
};

&i2c6 {

	broken-runtime;
	clock-frequency = <1000000>;
	pinctrl-names = "default";
	i2c-sda-falling-time-ns = <10>;
	i2c-scl-falling-time-ns = <10>;
	i2c-sda-hold-time-ns = <10>;
	pinctrl-0 = <&i2c6_pinctrl>;
	status = "disable";
};

&i2c7 {

	roken-runtime;
	clock-frequency = <1000000>;
	i2c-sda-falling-time-ns = <10>;
	i2c-scl-falling-time-ns = <10>;
	i2c-sda-hold-time-ns = <10>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7_pinctrl>;
	status = "disable";
};

&i2cq0 {
	uid = <1>;
	ipc-sem = <1 0 12>;	// Master 1, bank 0, sem 12
	role = <ROLE_MASTER>;
};
&i2cq1 {
	uid = <1>;
	ipc-sem = <1 0 12>;	// Master 1, bank 0, sem 12
	role = <ROLE_MASTER>;
};
&i2cq2 {
	uid = <1>;
	ipc-sem = <1 0 12>;	// Master 1, bank 0, sem 12
	role = <ROLE_MASTER>;
};
&csi0 {
	uid = <1>;
	ipc-sem = <1 0 13>;	// Master 1, bank 0, sem 13
};
&csi1 {
	uid = <1>;
	ipc-sem = <1 0 13>;	// Master 1, bank 0, sem 13
};
&csi2 {
	uid = <1>;
	ipc-sem = <1 0 13>;	// Master 1, bank 0, sem 13
};
#if defined(CONFIG_VIDEO_BST_ISP_MULTI_OS)
&isp_bus {
	dma-ranges = <0x0 0xC0000000 0x8 0xDB400000 0x0 0x3E000000>,
		     <0x0 0x3E000000 0x0 0x3E000000 0x0 0x02000000>,	// Reserved to restrict IOVA area
		     <0x0 0x40000000 0x0 0x20000000 0x0 0x07000000>,	// Outer registers area
		     <0x0 0x47000000 0x0 0x30000000 0x0 0x01000000>,	// Outer registers area
		     <0x0 0x50000000 0x0 0x50000000 0x0 0x10000000>,	// ISPCV inner registers
		     <0x0 0x60000000 0x8 0x00200000 0x0 0x00600000>,	// IPC area, see bst_ipc_reserved, 2MB aligned
		     <0x0 0x60600000 0x8 0x21000000 0x0 0x16000000>;	// For isp_fw_msg_rsv, isp_fw_buf_rsv
};
#endif
&isp {
	uid = <1>;
	msgbox-cpu = <CPU_6 0 0>;
	ipc-cpu = <3>;		// ARM3
	ipc-sem = <1 0 14>;	// Master 1, bank 0, sem 14
	role = <ROLE_MASTER>;
};

&uart0 {
	status = "disable";
};
&uart1 {
		dmas = <&gdma0 53>,
			<&gdma0 52>;
	dma-names = "tx", "rx";
	status = "okay";
};
&uart2 {
	status = "disable";
};
&uart3 {
	status = "disable";
};

&spi0 {
	status = "disable";
	clocks= <&scmi_clk GATE_LSP0_SSI_M_WCLK_EN>,
		<&scmi_clk GATE_LSP0_SSI_M_PCLK_EN>;
	clock-names = "wclk", "pclk";
	resets = <&scmi_reset RST_LSP0_SSI_M_WCLK_SW>;
	reset-names = "spi";
};
&spi1 {
	status = "disable";
	clocks= <&scmi_clk GATE_LSP0_SSI_S_WCLK_EN>,
		<&scmi_clk GATE_LSP0_SSI_S_PCLK_EN>;
	clock-names = "wclk", "pclk";
	resets = <&scmi_reset RST_LSP0_SSI_S_WCLK_SW>;
	reset-names = "spi";
};
&spi2 {
	status = "disable";
	clocks= <&scmi_clk GATE_LSP1_SSI_M_WCLK_EN>,
		<&scmi_clk GATE_LSP1_SSI_M_PCLK_EN>;
	clock-names = "wclk", "pclk";
	resets = <&scmi_reset RST_LSP1_SSI_M_WCLK_SW>;
	reset-names = "spi";
};
&spi3 {
	status = "disable";
	clocks= <&scmi_clk GATE_LSP1_SSI_S_WCLK_EN>,
		<&scmi_clk GATE_LSP1_SSI_S_PCLK_EN>;
	clock-names = "wclk", "pclk";
	resets = <&scmi_reset RST_LSP1_SSI_S_WCLK_SW>;
	reset-names = "spi";
};

&i2s0 {
	status = "disable";
};
&i2s1 {
	status = "disable";
};
&i2s2 {
	status = "disable";
};
&i2s3 {
	status = "disable";
};

&tdm0 {
	status = "disable";
};
&tdm1 {
	status = "disable";
};
&tdm2 {
	status = "disable";
};
&tdm3 {
	status = "disable";
};

&watchdog0 {
	status = "disable";
};
&watchdog1 {
	status = "disable";
};
&watchdog2 {
	status = "disable";
};
&watchdog3 {
	status = "disable";
};
&watchdog_soc0 {
	status = "disable";
};
&watchdog_soc1 {
	status = "disable";
};
&watchdog_soc2 {
	status = "disable";
};
&watchdog_soc3 {
	status = "disable";
};

&watchdog_soc4 {
	status = "okay";
};
&watchdog_soc5 {
	status = "okay";
};
&watchdog_soc6 {
	status = "okay";
};
&watchdog_soc7 {
	status = "okay";
};
&watchdog_db0 {
	status = "disable";
};
&watchdog_db1 {
	status = "disable";
};
&watchdog_db2 {
	status = "disable";
};
&watchdog_db3 {
	status = "disable";
