};

&gpu_db {
	status = "disable";
};

&pinctrl {
	status = "disable";
};

&gtc {
	status = "okay";
};

&xgmac0 {
	status = "okay";
	max-speed = <1000>;
	snps,ps-speed = <1000>;
	phy-handle = <&eth_phy0>;
	extend-op = <20>;
	phy-mode = "sgmii";
	mac-mode = "gmii";
	fpe-hs = <0>;
	xpcs-addr = <0>;
	dma-coherent-pop;
	snps,tso;
	/*bypass;  //bool, set: bypass , non set : non bypass
	pinctrl-names = "default";
        pinctrl-0 = <&soc_xgmac_pinctrl>;*/
	fixed-link {
		speed = <1000>;
		full-duplex;
		pause;
	};
	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";
		eth_phy0: eth_phy0@0 {
			compatible = "marvell,88E1510", "ethernet-phy-id0141.0DD1", "ethernet-phy-ieee802.3-c22";
			device_type = "ethernet-phy";
			max-speed = <1000>;
			reg = <0x1>;
			reset-active-low;
			reset-gpios = <&porte 16 1>; //gpio 144
			reset-assert-us = <20000>;
			reset-deassert-us = <20000>;
		};

	};
};

