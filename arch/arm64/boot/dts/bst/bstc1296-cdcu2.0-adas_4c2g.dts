&gpiokeys {
	status = "disable";
	//status = "okay"; //for STR SW3 WAKEUP
};

&thermal {
	status = "okay";
};

&can0 {
	status = "okay";
};

&swdma0 {
	status = "disable";
};

&gdma0 {
	status = "okay";
	dma-channels = <14>;
        snps,chan-start = <16>;
        snps,block-size = <1048576 1048576 1048576 1048576 1048576 1048576 1048576 1048576
                           1048576 1048576 1048576 1048576 1048576 1048576 >;

        snps,priority = <29 28 27 26 25 24
                        23 22 21 20 19 18 17 16>;
        interrupts =    <   GIC_SPI 401 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
                            GIC_SPI 402 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
                            GIC_SPI 403 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
                            GIC_SPI 404 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
                            GIC_SPI 405 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
                            GIC_SPI 406 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
                            GIC_SPI 407 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
                            GIC_SPI 408 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
                            GIC_SPI 409 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
                            GIC_SPI 410 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
                            GIC_SPI 411 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
                            GIC_SPI 412 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
                            GIC_SPI 413 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)
                            GIC_SPI 414 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_HIGH)>;

};

&mmu600_soc{
	status = "okay";
