	ipc-pid = "ARM2"; /* "ARM2"/"ARM3" */
};

&bst_virt_dpu0 {
	status = "okay";
	os-type = "ADAS";
	pipeline@0 {
		status = "okay";
		layer-num = <4>;
		port@0 {
			virt_pipe0_out: endpoint@0 {
				remote-endpoint = <&virt_lvds0_in>;
			};
		};
	};
	pipeline@1 {
		status = "okay";
		layer-num = <1>;
		port@0 {
			reg = <0>;
			virt_pipe1_out: endpoint@0 {
				remote-endpoint = <&virt_lvds1_in>;
			};
		};
	};
};

&bst_virt_lvds0 {
	status = "okay";
	backlight = <&backlight_lvds0>;
	ports {
		port@0 {
			virt_lvds0_in: endpoint@0 {
				remote-endpoint = <&virt_pipe0_out>;
			};
		};
	};
};

&bst_virt_lvds1 {
	status = "okay";
	backlight = <&backlight_lvds1>;
	ports {
		port@0 {
			virt_lvds1_in: endpoint@0 {
				remote-endpoint = <&virt_pipe1_out>;
			};
		};
	};
};

