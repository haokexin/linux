&usbdwc2 {
		//iommus = <&mmu600_soc 2>;
};
&dwc3 {
	status = "disable";
};

&timer0 {
       status = "disable";
};

&timer1 {
    interrupts = <GIC_SPI 253 IRQ_TYPE_LEVEL_HIGH>;
    timer-chan = <0x0>;
    status = "okay";
};


&mmc0 {
	memory-region = <&bst_sramemmc0_reserved>;

	pinctrl-names = "default","sd_pvdd3-3","sd_pvdd1-8";
	pinctrl-0 = <&mmc_pinctrl &mmc_pinctrl1>;
	pinctrl-1 = <&mmc_pinconfig>;
	pinctrl-2 = <&mmc_pinconfig1>;


	status = "okay";
};

&nor_flash {
	memory-region = <&bst_nor_flash_code_reserved>;
	status = "okay";
};


&mmu600_pcie {
	status = "disable";
};
&mmu600_codec {
	status = "disable";
};

&mmu600_coreip {
	status = "okay";
};

&ufs {
    interrupts = <GIC_SPI 118 IRQ_TYPE_EDGE_RISING
					GIC_SPI 253 IRQ_TYPE_LEVEL_HIGH>; 
	ufs-timer = <0x0>;
    status = "okay";
};

&pcie_phy {
	dmc-lane = <0x1>; /* bit0: 1=2x2ports, 0=1x4ports */
	dmc-mode = <0x3>; /* (bit1 for ctl0)/(bit0 for ctl1):1=RC-mode, 0=EP-mode */
	pcie-ctl0 = <1>;  /* Controller reset */
	pcie-ctl1 = <1>;  /* Controller reset */
	pcie-ref-clk0 = <1>; /* 0=onchip_clk, 1=pad_clk*/
	pcie-ref-clk1 = <1>; /* 0=onchip_clk, 1=pad_clk, 2=repeat_clk */
};

&pcie1 {
	status = "okay";
	reset-gpio = <&portg 25 GPIO_ACTIVE_HIGH>;
	reset-gpio-active-high;
	pre-init;
};

