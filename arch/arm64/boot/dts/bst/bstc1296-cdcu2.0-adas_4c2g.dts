&virtouch {
	status = "okay";
	memory-region = <&bst_touchscreen_reserved>;
	/*
	 * client-id:
	 * 0x41444153: "ADAS"
	 * 0x49564920: "IVI "
	 * 0x44422020: "DB  "
	 */
	client-id = <0x41444153>; // as same as display client id
	/*
	 * screens-id:
	 * 0x9: screen_lvds0  adas
	 * 0xa: screen_lvds1  adas/ivi/db
	 * 0x7: screen_dsi0  ivi
	 * 0x8: screen_dsi1  ivi
	 * 0x6: screen_edp   adas/ivi
	 */
	screens-id = <0x9>, <0xa>, <0x6>;
};

