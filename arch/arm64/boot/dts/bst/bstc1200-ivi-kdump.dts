&lsp0_pwm0 {
	status = "disable";
};
&lsp1_pwm0 {
	status = "disable";
};

&gpio0 {
	status = "disable";
};
&gpio1 {
	status = "disable";
};
&gpio2 {
	status = "disable";
};
&gpio3 {
	status = "disable";
};
&gpio4 {
	status = "disable";
};
&gpio5 {
	status = "disable";
};
&gpio6 {
	status = "disable";
};
&gpio7 {
	status = "disable";
};
&gpiokeys {
	status = "disable";
};

&gdma0 {
	status = "okay";
};

&swdma0 {
	status = "disable";
};

&mmu600_soc{
	status = "okay";
};


&usbdwc3 {
		iommus = <&mmu600_soc 1>;
};

&usbdrd_dwc3 {
	status = "okay";
};

&usbdwc2 {
		iommus = <&mmu600_soc 2>;
};
&dwc3 {
	status = "okay";
};

&mmc0 {
	status = "disable";
};
&mmc1 {
	status = "disable";
};

&nor_flash {
	memory-region = <&bst_nor_flash_code_reserved>;
	status = "okay";
};

&mmu600_codec {
	status = "disable";
};
&mmu600_soc {
	status = "disable";
};

&ufs {
	reg = <0x0 0x23005f00 0 0x100>,
		  <0x0 0x20011000 0 0x1000>;
    interrupts = <GIC_SPI 184 IRQ_TYPE_LEVEL_HIGH
					GIC_SPI 218 IRQ_TYPE_LEVEL_HIGH>; 
	ufs-timer = <0x0>;
	status = "okay";
};

&lvds_conn {
	status = "disable";
};

&pinctrl {
	status = "disable";
};

&clkc {
	status = "disable";
};

&xgmac0 {
	status = "disable";
};

&gic600 {
	status = "okay";
	};

&its0_x4 {
	status = "okay";
};

&ipc {
	status = "okay";
	memory-region = <&bst_ipc_reserved>;
};

&mbox {
	status = "okay";
	ipc-cpus = <0>;
	memory-region = <&bst_ipc_reserved>;
};


&msgbox {
	status = "okay";
	spi-irq-num = <4>;
	filter-num = <8>;
	// id = <0x0>;
	// end0 and end1 spi irq
	interrupts =    <
			GIC_PPI 2 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
			GIC_PPI 3 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
			GIC_PPI 4 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
			GIC_PPI 15 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
			GIC_SPI 544 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 545 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 546 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 547 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 548 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 549 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 550 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 551 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 552 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 553 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 554 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 555 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 556 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 557 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 558 (IRQ_TYPE_LEVEL_HIGH)
			GIC_SPI 559 (IRQ_TYPE_LEVEL_HIGH)
			>;
	#mbox-cells = <0x1>;
};

&arm_pmu {
	status = "disable";
};

&timer0 {
    interrupts = <GIC_SPI 218 IRQ_TYPE_LEVEL_HIGH>;
       timer-chan = <0x0>;
    status = "okay";
};

&timer1 {
       status = "disable";
};

