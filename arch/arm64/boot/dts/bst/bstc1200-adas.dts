	status = "okay";
};

&xgmac0 {
	status = "okay";
	max-speed = <1000>;
	snps,ps-speed = <1000>;
	phy-handle = <&eth_phy0>;
	extend-op = <20>;
	phy-mode = "sgmii";
	mac-mode = "gmii";
	fpe-hs = <0>;
	/*bypass;  //bool, set: bypass , non set : non bypass
	pinctrl-names = "default";
        pinctrl-0 = <&soc_xgmac_pinctrl>;*/
	fixed-link {
		speed = <1000>;
		full-duplex;
		pause;
	};
	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";
		eth_phy0: eth_phy0@0 {
			compatible = "marvell,88E1510", "ethernet-phy-id0141.0DD1", "ethernet-phy-ieee802.3-c22";
			device_type = "ethernet-phy";
			max-speed = <1000>;
			reg = <0x1>;
			reset-active-low;
			reset-gpios = <&porte 16 1>; //gpio 144
			reset-assert-us = <20000>;
			reset-deassert-us = <20000>;
		};

	};
};

&hif {
	status = "disable";
};

&gic600 {
	status = "okay";
};

&its1_x2 {
	status = "okay";
	memory-region = <&its_table_reserved>;
};

&msgbox {
	status = "okay";
	spi-irq-num = <4>;
	filter-num = <8>;
	// id = <0x0>;
	// end0 and end1 spi irq
	interrupts =    <
			GIC_PPI 2 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
			GIC_PPI 3 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
			GIC_PPI 4 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
			GIC_PPI 15 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)
            GIC_SPI 560 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 561 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 562 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 563 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 564 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 565 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 566 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 567 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 568 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 569 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 570 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 571 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 572 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 573 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 574 (IRQ_TYPE_LEVEL_HIGH)
            GIC_SPI 575 (IRQ_TYPE_LEVEL_HIGH)
			>;
	#mbox-cells = <0x1>;
};

&arm_pmu {
	status = "disable";
};

&hwcv {
	memory-region = <&coreip_reserved>;
	status = "okay";
};

&ipc {
	status = "okay";
	memory-region = <&bst_ipc_reserved>;
};
&mbox {
	status = "okay";
	memory-region = <&bst_ipc_reserved>;
};
&bst_cvsmm {
	status = "okay";
	iommus = <&mmu600_coreip 2>;
	dma-coherent;
};
&bstn {
	status = "okay";
	memory-region = <&coreip_reserved>;
	//iommus = <&mmu600_coreip 1>,<&mmu600_coreip 4>;
	//dma-coherent;
};
&lwnn {
	status = "okay";
	memory-region = <&coreip_reserved>;
};
&cv {
	status = "disable";
	memory-region = <&bst_cv_reserved>;
};
