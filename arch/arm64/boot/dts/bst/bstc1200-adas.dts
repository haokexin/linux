};

&bst_virt_dpu0 {
	status = "okay";
	memory-region = <&bst_dpu_reserved>;
	os-type = "ADAS_LINUX";
	pipeline@0 {
		status = "okay";
		layer-num = <4>;
		dc-type = "DEVICE_TYPE_VIRT_DC_PIPE1";
		port@0 {
			virt_pipe0_out: endpoint@0 {
				remote-endpoint = <&virt_lvds0_in>;
			};
		};
	};
	pipeline@1 {
		status = "okay";
		dc-type = "DEVICE_TYPE_VIRT_DC_PIPE2";
		layer-num = <1>;
		port@0 {
			virt_pipe1_out: endpoint@0 {
				remote-endpoint = <&virt_dptx_in>;
			};
		};
	};
	pipeline@2 {
		status = "okay";
		dc-type = "DEVICE_TYPE_VIRT_DC_PIPE3";
		layer-num = <1>;
		port@0 {
			reg = <0>;
			virt_pipe2_out: endpoint@0 {
				remote-endpoint = <&virt_lvds1_in>;
			};
		};
	};
};

&bst_virt_lvds0 {
	status = "okay";
	ports {
		port@0 {
			virt_lvds0_in: endpoint@0 {
				remote-endpoint = <&virt_pipe0_out>;
			};
		};
	};
};

&bst_virt_lvds1 {
	status = "okay";
	ports {
		port@0 {
			virt_lvds1_in: endpoint@0 {
				remote-endpoint = <&virt_pipe2_out>;
			};
		};
	};
};

&bst_virt_dptx {
	status = "okay";
