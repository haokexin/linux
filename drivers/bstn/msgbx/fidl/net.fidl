package com.bst.ipc.coreip


interface net{
    version {major 1  minor 0}
    
    enumeration ErrorEnum {
        NO_ERROR = 0
        SERVER_FAIL = -1
        ERROR_PARA = -2
        ERROR_SYS = -3
    }

    method disp_req {
        in {
            UInt32 req
        }
        out {
            UInt32 rep
        }
        error ErrorEnum
    }

    method disp_run {
        in {
            UInt32 opcode
            UInt32 opdata
        }
        out {
            UInt32 status
            UInt32 perf_us      //性能记录
        }
        error ErrorEnum
    }



}

interface net_safety{

    version {major 1  minor 0}

    enumeration ErrorEnum {
        NO_ERROR = 0
        SERVER_FAIL = -1
        ERROR_2 = -2
        ERROR_3 = -3
    }
    
    method fusaenable_method{
        in {
            UInt8 block_id
        }
        out {
            UInt8 block_id_out
            UInt32[4] psm_id
        }
        error ErrorEnum
    }
}