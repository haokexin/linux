import "net-inf.fdepl"

define com.bst.ipc.deployment for provider as bstn_client {
    ProviderType = Client
    RTE = LinuxKernel
    SrcEndID = CPU_3
    FID = DEF
    SID = 10
    EnableRouterRealtimeSched = true
    RouterPriority = 99
    instance com.bst.ipc.coreip.net {
        DstEndID = NET_0
    }
    
    instance com.bst.ipc.coreip.net_safety {
        DstEndID = SAFETY_0
    }
}