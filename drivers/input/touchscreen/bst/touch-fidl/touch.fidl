//touch.fidl

//package名，前缀统一为com.bst.ipc，XXX为模块名，由对应模块的开发人员确定，如safety/security/realtime/isp/net等。
package com.bst.ipc.soc

//为简化使用场景，禁用import。
//为简化使用场景，降低interface间的耦合度，禁用typeCollection。
//为简化使用场景，禁用contract。

//interface为一组服务的集合，同一模块下可有一组或多组interface。
//为简化使用场景，IPC接口描述中，禁用了interface的extends/manages特性
//interface命名以简洁清晰为准，或以缩写代替，如BST_HSM/BST_DMA。命名时，不建议加入芯片名称，这会对跨芯片移植造成困难，如C1200_HSM等。
interface bst_touch{
    //version为必填项。版本规则为：
    //1. major改变意味着接口的彻底变化，如method/broadcast的名称变化，参数变化，数量变化等。
    //2. minor改变意味着有接口中有新增的method/broadcast。
    //3. 在major不变，minor增加时，只可新增method/broadcast，不可修改/删除原有method/broadcast。
    version {major 1  minor 0}
    
    //为简化使用场景，禁用attribute关键字
    
    // 数据类型定义，分原生数据类型和派生数据类型两类。
    // 原生数据类型可直接使用，注意大小写。包括：Int8/UInt8/Int16/UInt16/Int32/UInt32/Int64/UInt64/Boolean/Float/Double/String。为简化使用场景，禁用Integer，ByteBuffer类型。ByteBuffer为Int8类型的数组。
    // 派生数据类型需要定义，包括array, enumeration, struct, union, typedef
    // 为简化使用场景，禁止使用匿名数组，即Type []，如UInt8 []
    // 为简化使用场景，禁用map类型，禁用enumeration/struct/union的继承功能（extends关键字），禁用struct的polymorphic关键字
    // 注意：没有指针类型，没有指针类型，没有指针类型，可以考虑使用ByteBuffer替代
    // 注意2：类型系统没有隐式类型转换
    // 注意3：array的基础类型不要是String/ByteBuffer，以及包含String/ByteBuffer的结构体及其typedef。
    // 注意4：union不要包含String/ByteBuffer，以及包含String/ByteBuffer的结构体及其typedef。
	
        //常量定义
    //原生数据类型常量定义
    //为简化使用场景，禁用ByteBuffer类型常量
    //为简化使用场景，禁用复杂数据类型常量，如array, struct, union等。

    //禁用复杂数据类型常量

    enumeration ErrorEnum {
        NO_ERROR = 0
        SERVER_FAIL = -1
        ERROR_2 = -2
        ERROR_3 = -3
        ERROR_COMMON = 120
        ERROR_SCREEN_ID_INVALID = 128
        ERROR_SCREEN_NUM_OVERLIMIT = 129
        ERROR_CLIENT_NUM_OVERLIMIT
        ERROR_RESEVERD
    }

    // some macro
    enumeration MacroEnum {
        MAX_SCREEN = 5
        MAX_CLIENT = 10
        MAX_POINT_NUM = 10
        //screen_id
        SCREENID_LVDS0 = 9  //adas
        SCREENID_LVDS1 = 10  //db
        SCREENID_DSI0 = 7    //ivi third screen
        SCREENID_DSI1 = 8    //ivi second screen
        SCREENID_EDP = 6     // ivi main screen
        // touchscreen vendor
        VENDOR_ID_SYNA = 0x0001
        VENDOR_ID_HIMAX = 0x0002
        // touchscreen product
        PRODUCT_ID_SYNA_DEF = 0x01
        PRODUCT_ID_HIMAX_DEF = 0x01
        PRODUCT_ID_HIMAX_83192A = 0x02
        PRODUCT_ID_HIMAX_83192D = 0x03
        PRODUCT_ID_HIMAX_83193A = 0x04
        PRODUCT_ID_HIMAX_83180A = 0x05
        //touchscreen version
        VERSION_ID_SYNA_DEF = 0x01
        VERSION_ID_HIMAX_DEF = 0x01
    }

    //request touchscreen resouce
    //array FixedArray of UInt8(32)
    enumeration TransportProtoEnum {
        TRANSPORT_PROTOTYPE_FULL = 0
        TRANSPORT_PROTOTYPE_CHANGE
    }
    struct hw_info {
        UInt32 screen_id //bst规定的屏幕编号，用于区别其他屏
        UInt16 vendor
        UInt16 product
        UInt16 versions
        UInt16 x_min
        UInt16 x_max
        UInt16 y_min
        UInt16 y_max
        UInt16 pressure_min
        UInt16 pressure_max
        UInt16 touch_num_max
        UInt8 transport_proto
        UInt8 connected
        UInt8[32] name
        UInt8[32] phys 
    }
    //typedef ts_hwinfo is hw_info
    struct request_info {
        UInt32 screen_id
        UInt32 shmem_size
        UInt64 shmem_paddr
    }

    method client_request_location_init {
        in {
            UInt32 client_id
            request_info req_info
        }
        out {
            UInt64 client_uuid
            hw_info screen_hwinfo
        }
        error ErrorEnum
    }
    // The end of request touchscreen resouce

    //calibration location info
    struct calibration_info {
        UInt32 a_factor // (Xd,Yd) is touch device output coordinates
        UInt32 b_factor // (Xs,Ys) is screen coordinates
        UInt32 c_factor // s*Xs = a*Xd + b*Yd + c
        UInt32 d_factor // s*Ys = d*Xd + e*Yd + f
        UInt32 e_factor //
        UInt32 f_factor //
        UInt32 s_factor //
    }
    method set_touch_calibration {
        in {
            UInt32 screen_id
            calibration_info cali_info
        }
        error ErrorEnum
    }
    method get_touch_calibration {
        in {
            UInt32 screen_id
        }
        out {
            calibration_info cali_info
        }
        error ErrorEnum
    }
    // The end of calibration location info

    // touch debug cmd
    method touch_debug_cmd {
        in {
            String cmd_str
        }
        out {
            String result_str
        }
        error ErrorEnum
    }
    // The end of touch debug cmd

    //touch data
    struct point_data {
        UInt16 pressure //按下、举起等动作
        Int16 x_pos  //x_pos
        Int16 y_pos
        UInt16 distance
        UInt16 orientation
        UInt16 touch_major
        UInt16 touch_minor
        UInt16 width_major
        UInt16 width_minor
        UInt8 tool_type
        UInt8 tracking_id
    }
    //array point_data_array of point_data //不定长数组

    struct point_info {
        UInt32 screen_id //触摸屏物理id
        UInt16 slots //多点触摸触点个数，最大不超过MAX_TOUCH_PONIT_NUM
        //point_data_array point_lists //不定长数组
        point_data[10] point_lists //定长数组：这里数字必须等于MAX_POINT_NUM
    }
    
    // broadcast定义
    // 为简化使用场景，禁用broadcast的selective标签，禁止broadcast重载和重载标签，即不允许同名broadcast。
    // broadcast默认会在代码生成时生成配套的register/unregister方法。只有调用了register方法的client才会收到server发出的 broadcast。

//#ifdef USE_SHAREMEM_POINTINFO
    broadcast location_info selective {
         // broadcast的输出参数表，输出参数禁止重名。
        out {
            UInt32 screen_id
            UInt32 locinfo_offset
            UInt32 locinfo_size
            UInt32 locinfo_chksum
        }
    }
//#else
    /*broadcast location_info selective {
         // broadcast的输出参数表，输出参数禁止重名。
        out {
            UInt32 client_id //TODO: remove it
            point_info locinfo
        }
    }*/
//#endif
    /*broadcast location_info_toivi {
         // broadcast的输出参数表，输出参数禁止重名。
        out {
            UInt32 client_id
            point_info locinfo
        }
    }
    broadcast location_info_toadas {
         // broadcast的输出参数表，输出参数禁止重名。
        out {
            UInt32 client_id
            point_info locinfo
        }
    }*/
}

// 注释说明
// 注释分为非结构化注释和结构化注释。
// 非结构化注释用于说明fidl/fdepl文件的相关内容，可使用“//”或者“/**/”两种形态。
// 结构化注释用于生成API文档。它放于每一个等说明元素前，包括interface/array/struct/enumeration/union/typedef/constant/method/broadcast，以及上述元素的成员变量表、参数表等。
// 结构化注释的格式为：
// <∗∗ @description : This is the constant MyConst, which is 10 as UInt8.
//     @author : ding.wang ∗∗> 
// constant UInt8 a = 10
// 可使用的标签如下：
// @description, @author, @deprecated, @source−uri, @source−alias, @see, @experimental
