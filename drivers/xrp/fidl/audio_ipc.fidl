//sample.fidl

//package名，前缀统一为com.bst.ipc，XXX为模块名，由对应模块的开发人员确定，如safety/security/realtime/isp/net等。
package com.bst.ipc.audio

//为简化使用场景，禁用import。
//为简化使用场景，降低interface间的耦合度，禁用typeCollection。
//为简化使用场景，禁用contract。

//interface为一组服务的集合，同一模块下可有一组或多组interface。
//为简化使用场景，IPC接口描述中，禁用了interface的extends/manages特性
//interface命名以简洁清晰为准，或以缩写代替，如BST_HSM/BST_DMA。命名时，不建议加入芯片名称，这会对跨芯片移植造成困难，如C1200_HSM等。
interface audio_ipc{
	//version为必填项。版本规则为：
	//1. major改变意味着接口的彻底变化，如method/broadcast的名称变化，参数变化，数量变化等。
	//2. minor改变意味着有接口中有新增的method/broadcast。
	//3. 在major不变，minor增加时，只可新增method/broadcast，不可修改/删除原有method/broadcast。
	version {major 1  minor 0}
	
	//为简化使用场景，禁用attribute关键字
	
	// 数据类型定义，分原生数据类型和派生数据类型两类。
	// 原生数据类型可直接使用，注意大小写。包括：Int8/UInt8/Int16/UInt16/Int32/UInt32/Int64/UInt64/Boolean/Float/Double/String。为简化使用场景，禁用Integer，ByteBuffer类型。ByteBuffer为Int8类型的数组。
	// 派生数据类型需要定义，包括array, enumeration, struct, union, typedef
	// 为简化使用场景，禁止使用匿名数组，即Type []，如UInt8 []
	// 为简化使用场景，禁用map类型，禁用enumeration/struct/union的继承功能（extends关键字），禁用struct的polymorphic关键字
	// 注意：没有指针类型，没有指针类型，没有指针类型，可以考虑使用ByteBuffer替代
	// 注意2：类型系统没有隐式类型转换
	// 注意3：array的基础类型不要是String/ByteBuffer，以及包含String/ByteBuffer的结构体及其typedef。
	// 注意4：union不要包含String/ByteBuffer，以及包含String/ByteBuffer的结构体及其typedef。
	array MyArray of UInt16
	enumeration ErrorEnum {
		NO_ERROR = 0
		SERVER_FAIL = -1
		ERROR_2 = -2
		ERROR_3 = -3
	}

	enumeration DataReadyTypeEnum {
		DATA_READY_IN_PING = 0
		DATA_READY_IN_PANG = 1
	}

	struct MyStruct {
		UInt8 m1
		Boolean m2
		//named array
		MyArray m3
		String m4
		ByteBuffer m5
	}
	union MyUnion {
		UInt8 m1
		UInt16 m2
		UInt32 m3
	}
	struct XrpDspCmd {
		UInt32 flags
		UInt32 in_data_size
		UInt32 out_data_size
		UInt32 buffer_size
		UInt32 in_data_addr
		ByteBuffer in_data
		UInt32 out_data_addr
		ByteBuffer out_data
		UInt32 buffer_addr
		ByteBuffer buffer_data
		ByteBuffer buffer_alignment
		ByteBuffer nsid
	}
	
	//常量定义
	//原生数据类型常量定义
	//为简化使用场景，禁用ByteBuffer类型常量
	//为简化使用场景，禁用复杂数据类型常量，如array, struct, union等。
	const Boolean b1 = true 
	const UInt32 MAX_COUNT = 10000 
	const UInt16 SOME_ID = 0xA00B 
	const UInt8 BYTE_ME = 0b00110011 
	const Double pi = 3.1415d

	//禁用复杂数据类型常量
	// const MyArray empty = [] 
	// const MyArray full = [ 1, 2, 2+3, 100∗100+100 ] 
	// const MyStruct s1 = { m1: 10, m2: true, m3: [1,2,3], m4: "foo", m5: "" } 
	
	//method定义
	// 为简化使用场景，禁止method重载及重载标签，即不允许同名method存在。
	method hello {
		// 输入参数定义，可选
		in {
			String name
		}
		// 输出参数定义，可选
		// 注意：输入和输出参数不允许重名，也不允许输入参数与输出参数重名。
		out {
			String message
		}
		// 错误定义，可选
		// 错误定义两种形式，第一种为匿名枚举，如下：
		// error {
		//	 DIVISION_BY_ZERO 
		//	 OVERFLOW 
		//	 UNDERFLOW 
		// }
		// 第二种为命名枚举，如下：
		// error MyEnum
		// 为简化使用场景，禁用error的extends枚举用法。
		// 考虑到错误码共用及C语言唯一命名空间的影响，推荐做法为：在Interface中为所有method定义统一的ErrorEnum，其中必须包含NO_ERROR=0和SERVER_FAIL=-1
		error ErrorEnum
	}
	// more complex method definition
	method slt_method {
		in {
			UInt32 bin_index
		}
		out {
			UInt32 reply_result
		}
		error ErrorEnum
	}
	// 对于无out和error的method，可附加fireAndForget标识，该标识表明该method无需回复，在client端不会等待响应或触发回调，在server端无需发送此method的reply。
	// 考虑到IPC丢包的可能性，使用fireAndForget的场景应当经过仔细评估，不建议广泛使用。
	method no_reply_method fireAndForget { 
		in {
			UInt8 status
		}
	} 

	method xrp_shmem_addr_method {
		in {
			XrpDspCmd in_cmd
		}
		out {
			XrpDspCmd out_cmd
		}
		error ErrorEnum
	}

	method set_scenario {
		in {
			String scenario_name
		}
		error ErrorEnum
	}

	method get_cur_scenario {
		out {
			 String scenario_name
		}
		error ErrorEnum
	}

	method audio_config {
		in {
			UInt8 channel
			UInt32 sample_rate
			UInt8 data_width
			UInt8 direction
		}
		out {
			UInt8 result
		}
		error ErrorEnum
	}

	method ctrl_cmd {
		in {
			UInt8 channel
			UInt8 func_id
			ByteBuffer in_data
		}
		out {
			UInt8 result
		}
		error ErrorEnum
	}

	method start_stop_to_play {
		in {
			UInt8 chn
			UInt8 sts
			UInt8 direction
		}
		out {
			UInt8 result
		}
		error ErrorEnum
	}

	method send_dma_buff_global_fd {
		in {
			Int64 gFd
			Int64 size
		}
		out {
			UInt8 result
		}
		error ErrorEnum
	}

	method data_ready_in_pingpong_buff {
		in {
			Boolean isPing
		}
		out {
			UInt8 result
		}
		error ErrorEnum
	}

	// broadcast定义
	// 为简化使用场景，禁止broadcast重载和重载标签，即不允许同名broadcast。
	// broadcast默认会在代码生成时生成配套的register/unregister方法。只有调用了register方法的client才会收到server发出的broadcast。
	broadcast heartbeat {
		// broadcast的输出参数表，输出参数禁止重名。
		out {
			UInt8 status
		}
	}
	
	broadcast kws_triggered {
		out {
			UInt8 kws_result
		}
	}

	broadcast data_comsumed_event {
		out {
			UInt32 count
		}
	}
}

// 注释说明
// 注释分为非结构化注释和结构化注释。
// 非结构化注释用于说明fidl/fdepl文件的相关内容，可使用“//”或者“/**/”两种形态。
// 结构化注释用于生成API文档。它放于每一个等说明元素前，包括interface/array/struct/enumeration/union/typedef/constant/method/broadcast，以及上述元素的成员变量表、参数表等。
// 结构化注释的格式为：
// <∗∗ @description : This is the constant MyConst, which is 10 as UInt8.
//	 @author : ding.wang ∗∗> 
// constant UInt8 a = 10
// 可使用的标签如下：
// @description, @author, @deprecated, @source−uri, @source−alias, @see, @experimental
