import "cvdsp-inf.fdepl"

define com.bst.ipc.deployment for provider as lwnn_server {
    ProviderType = Server
    RTE = BareMetal
    SrcEndID = ISPCV_0
    // Note: Server FID MUST be set to DEF
    FID = DEF
    SID = 0
    instance com.bst.ipc.coreip.cvdsp {
        GenerateReplyMethod = true
        NotUseSwitchCase = false
    }
}
